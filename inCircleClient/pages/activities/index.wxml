<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>

<view class="page activities-page {{themeClass}}" style="{{tabBarInsetStyle}}" wx:if="{{!loading}}">
  <view class="top-panel motion-hero">
    <view>
      <view class="eyebrow">本周约局</view>
      <view class="page-title">把接龙变成一键表态</view>
      <view class="page-desc">活动、人数、费用、沉默名单和趣味复盘都在一张卡里。</view>
    </view>
    <view class="create-btn" bindtap="createActivity">发起</view>
  </view>

  <view class="activity-list">
    <empty-state
      wx:if="{{!activities.length}}"
      kind="activity"
      icon="/images/ui-icons/activity.png"
      eyebrow="第一局，从一个想法开始"
      title="还没有约局"
      description="发起吃饭、运动或桌游计划，圈友可以直接表态，人数进度也会自动整理。"
      action-text="发起第一局"
      spacious="{{true}}"
      bindaction="createActivity"
    />
    <block wx:else>
    <view class="activity-card card {{activityIndex < 6 ? 'motion-list-item' : ''}}" wx:for="{{activities}}" wx:key="id" wx:for-item="activity" wx:for-index="activityIndex" data-id="{{activity.id}}" bindtap="openActivity" style="animation-delay: {{activityIndex * 35}}ms;">
      <view class="card-head">
        <view class="activity-main">
          <view class="activity-type">
            <image class="label-icon" src="/images/ui-icons/activity.png"></image>
            <text>{{activity.type}}</text>
          </view>
          <view class="activity-title">{{activity.title}}</view>
          <view class="activity-meta">{{activity.time}} · {{activity.location}}</view>
        </view>
        <view class="pill {{activity.statusClass}}">{{activity.status}}</view>
      </view>

      <view class="detail-grid">
        <view class="detail-item">
          <view class="detail-value">{{activity.hostName}}</view>
          <view class="detail-label">发起人</view>
        </view>
        <view class="detail-item">
          <view class="detail-value">{{activity.fee}}</view>
          <view class="detail-label">费用</view>
        </view>
        <view class="detail-item">
          <view class="detail-value">缺 {{activity.needCount}} 人</view>
          <view class="detail-label">成局缺口</view>
        </view>
      </view>

      <view class="progress-block">
        <view class="progress-track">
          <view class="progress-fill motion-progress" style="width: {{activity.percent}}%;"></view>
        </view>
        <view class="progress-copy">已来 {{activity.coming}} / {{activity.capacity}}，待定 {{activity.pending.length}}，候补 {{activity.waitlist.length}}</view>
      </view>

      <view class="status-row">
        <view
          class="status-btn motion-state {{option.activeClass}} {{actionLoadingType === 'status' && actionLoadingId === activity.id ? 'disabled' : ''}}"
          wx:for="{{activity.statusOptions}}"
          wx:key="value"
          wx:for-item="option"
          data-id="{{activity.id}}"
          data-status="{{option.value}}"
          catchtap="chooseStatus"
        >
          <block wx:if="{{actionLoadingType === 'status' && actionLoadingId === activity.id && actionLoadingName === option.value}}">提交中...</block>
          <block wx:else>{{option.value}}</block>
        </view>
      </view>

      <view class="tag-row">
        <view class="mini-tag" wx:for="{{activity.tags}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="insight-box">
        <view class="insight-icon"><image src="/images/ui-icons/lightbulb.svg" mode="aspectFit"></image></view>
        <view class="insight-main">
          <view class="insight-line">{{activity.highlight}}</view>
          <view class="insight-meta">未表态：{{activity.silentText}}</view>
        </view>
      </view>

      <view class="activity-recap">
        <view class="activity-recap-title">
          <image src="/images/ui-icons/recap.svg" mode="aspectFit"></image>
          <text>趣味复盘</text>
        </view>
        <view class="activity-recap-values">
          <view class="activity-recap-item">
            <text class="activity-recap-label">本局 MVP</text>
            <text class="activity-recap-value">{{activity.recap.mvp}}</text>
          </view>
          <view class="activity-recap-divider"></view>
          <view class="activity-recap-item">
            <text class="activity-recap-label">早鸟</text>
            <text class="activity-recap-value">{{activity.recap.earlyBird}}</text>
          </view>
        </view>
      </view>

      <view class="activity-actions">
        <view wx:if="{{activity.canEdit}}" class="activity-action edit" catchtap="editActivity" data-id="{{activity.id}}">
          <image class="activity-action-icon" src="/images/ui-icons/edit.png" mode="aspectFit"></image>
          <text>编辑</text>
        </view>
        <button
          class="activity-action share"
          open-type="share"
          data-share-type="activity"
          data-id="{{activity.id}}"
          catchtap="prepareActivityShare"
        >
          <image class="activity-action-icon" src="/images/ui-icons/share.svg" mode="aspectFit"></image>
          <text>分享</text>
        </button>
        <view
          wx:if="{{activity.canDelete}}"
          class="activity-action danger {{actionLoadingType === 'delete' && actionLoadingId === activity.id ? 'disabled' : ''}}"
          catchtap="deleteActivity"
          data-id="{{activity.id}}"
        >
          <image class="activity-action-icon" src="/images/ui-icons/trash-2.svg" mode="aspectFit"></image>
          <text>{{actionLoadingType === 'delete' && actionLoadingId === activity.id ? '删除中' : '删除'}}</text>
        </view>
      </view>
    </view>
    </block>
  </view>

  <view class="sheet-mask" wx:if="{{showCreatePanel}}" bindtap="closeCreatePanel" catchtouchmove="noop">
    <view class="create-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-kicker">{{activityFormKicker}}</view>
          <view class="sheet-title">{{activityFormTitle}}</view>
        </view>
        <view class="sheet-close" bindtap="closeCreatePanel">×</view>
      </view>

      <view class="form-grid">
        <view class="field">
          <view class="field-label">活动名称</view>
          <input class="field-input" adjust-position="{{true}}" cursor-spacing="96" placeholder="例如：周六电影局" value="{{draft.title}}" data-field="title" bindinput="onDraftInput" />
        </view>
        <view class="field-row">
          <view class="field">
            <view class="field-label">类型</view>
            <picker range="{{typeOptions}}" bindchange="onTypeChange">
              <view class="field-picker">{{draft.type}}</view>
            </picker>
          </view>
          <view class="field">
            <view class="field-label">人数上限</view>
            <picker range="{{capacityOptions}}" bindchange="onCapacityChange">
              <view class="field-picker">{{draft.capacity}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <view class="field-label">时间</view>
          <input class="field-input" adjust-position="{{true}}" cursor-spacing="96" placeholder="例如：周六 19:30" value="{{draft.time}}" data-field="time" bindinput="onDraftInput" />
        </view>
        <view class="field">
          <view class="field-label">地点</view>
          <input class="field-input" adjust-position="{{true}}" cursor-spacing="96" placeholder="例如：万象城 5F" value="{{draft.location}}" data-field="location" bindinput="onDraftInput" />
          <view class="location-picker" bindtap="chooseActivityLocation">
            <view>
              <view class="location-picker-title">{{draft.mapLocationLabel}}</view>
              <view class="location-picker-copy">可用微信地图选点，详情页能展示更准确的位置。</view>
            </view>
            <view class="location-picker-action">选点</view>
          </view>
        </view>
        <view class="field">
          <view class="field-label">费用预估</view>
          <input class="field-input" adjust-position="{{true}}" cursor-spacing="96" placeholder="例如：约 80 元/人" value="{{draft.fee}}" data-field="fee" bindinput="onDraftInput" />
        </view>
      </view>

      <view class="sheet-tip">
        {{editingActivityId ? '活动结束后内容会锁定；修改时间或地点后记得通知已报名成员。' : '创建后会自动进入报名中，发起人默认为“我来”。'}}
      </view>
      <view class="form-submit-row">
        <view class="ghost-btn sheet-submit {{actionLoadingType === 'saveActivity' ? 'disabled' : ''}}" bindtap="submitActivity">
          {{actionLoadingType === 'saveActivity' ? '保存中...' : '保存'}}
        </view>
        <view
          class="primary-btn sheet-submit {{actionLoadingType === 'saveActivity' ? 'disabled' : ''}}"
          data-share-after="{{true}}"
          bindtap="submitActivity"
        >
          {{actionLoadingType === 'saveActivity' ? '保存中...' : '保存并分享'}}
        </view>
      </view>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{showShareSheet}}" bindtap="closeShareSheet" catchtouchmove="noop">
    <view class="share-ready-sheet" catchtap="noop">
      <view class="share-ready-handle"></view>
      <view class="share-ready-head">
        <view class="share-ready-mark"><image src="/images/ui-icons/check.svg" mode="aspectFit"></image></view>
        <view class="share-ready-body">
          <view class="share-ready-title">活动已保存</view>
          <view class="share-ready-copy">分享后，圈友可以直接查看安排并表态。</view>
        </view>
      </view>
      <view class="share-ready-actions">
        <view class="ghost-btn share-ready-secondary" bindtap="closeShareSheet">稍后再说</view>
        <button
          class="primary-btn share-ready-primary"
          open-type="share"
          data-share-type="activity"
          data-id="{{shareTargetActivity.id}}"
        >
          <image class="share-ready-action-icon" src="/images/ui-icons/share.svg" mode="aspectFit"></image>
          <text>分享给好友或群</text>
        </button>
      </view>
    </view>
  </view>
</view>

<view class="page activities-page loading-page {{themeClass}}" style="{{tabBarInsetStyle}}" wx:else>
  <view class="loading-panel">
    <view class="loading-illustration">
      <view class="loading-card-line first"></view>
      <view class="loading-card-line second"></view>
      <view class="loading-card-line third"></view>
      <view class="loading-card-mark"></view>
    </view>
    <view class="loading-text">正在整理约局...</view>
    <view class="loading-dots"><view></view><view></view><view></view></view>
  </view>
</view>
<ai-fab />
<theme-dialog id="incircle-theme-dialog" />
