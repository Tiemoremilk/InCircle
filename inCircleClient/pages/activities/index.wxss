.activities-page {
  padding-top: 24rpx;
}

.top-panel {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 58%, var(--theme-accent, #b8d966) 160%);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.top-panel::after {
  content: "";
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.eyebrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  line-height: 1.16;
  font-weight: 900;
}

.page-desc {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.create-btn {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 22rpx 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}

.activity-list {
  margin-top: 24rpx;
}

.activity-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.activity-main {
  flex: 1;
  min-width: 0;
}

.activity-type {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 800;
}

.label-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.activity-title {
  margin-top: 8rpx;
  color: #17211e;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.activity-meta {
  margin-top: 10rpx;
  color: #79827f;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.detail-item {
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: #f5f8f5;
}

.detail-value {
  color: #17211e;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-label {
  margin-top: 6rpx;
  color: #79827f;
  font-size: 20rpx;
}

.progress-block {
  margin-top: 24rpx;
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #edf0ee;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--theme-primary, #2f7d50), var(--theme-accent, #b8d966));
}

.progress-copy {
  margin-top: 10rpx;
  color: #4d5653;
  font-size: 23rpx;
}

.status-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.status-btn {
  height: 58rpx;
  border-radius: 12rpx;
  background: #eef2ef;
  color: #26312e;
  text-align: center;
  line-height: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status-btn.active {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.status-btn.disabled {
  opacity: 0.62;
}

.insight-box {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.14));
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
}

.insight-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 11rpx;
  background: rgba(255, 255, 255, 0.68);
}

.insight-icon image {
  width: 25rpx;
  height: 25rpx;
  filter: var(--theme-icon-filter, brightness(0) saturate(100%) invert(40%) sepia(22%) saturate(1023%) hue-rotate(93deg) brightness(96%) contrast(94%));
}

.insight-main {
  min-width: 0;
  flex: 1;
}

.insight-line {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 800;
}

.insight-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #74807b;
  font-size: 21rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-recap {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
}

.activity-recap-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  color: var(--theme-primary, #2f7d50);
  font-size: 22rpx;
  font-weight: 800;
}

.activity-recap-title image {
  width: 27rpx;
  height: 27rpx;
  filter: var(--theme-icon-filter, brightness(0) saturate(100%) invert(40%) sepia(22%) saturate(1023%) hue-rotate(93deg) brightness(96%) contrast(94%));
}

.activity-recap-values {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  min-width: 0;
  flex: 1;
}

.activity-recap-item {
  min-width: 0;
  text-align: right;
}

.activity-recap-label {
  display: block;
  color: #89928e;
  font-size: 19rpx;
  line-height: 1.2;
}

.activity-recap-value {
  display: block;
  max-width: 150rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #2b3532;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-recap-divider {
  width: 1rpx;
  height: 38rpx;
  flex: 0 0 1rpx;
  background: var(--theme-card-border, rgba(47, 125, 80, 0.1));
}

.activity-actions {
  display: flex;
  gap: 12rpx;
}

.activity-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  height: 62rpx;
  flex: 1;
  padding: 0 14rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.14));
  border-radius: 10rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
}

.activity-action.share {
  border-color: transparent;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.activity-action.danger {
  border-color: rgba(179, 74, 52, 0.16);
  background: #fff5f2;
  color: #b34a34;
}

.activity-action-icon {
  width: 25rpx;
  height: 25rpx;
  flex-shrink: 0;
  filter: var(--theme-icon-filter, brightness(0) saturate(100%) invert(40%) sepia(22%) saturate(1023%) hue-rotate(93deg) brightness(96%) contrast(94%));
}

.activity-action.share .activity-action-icon {
  filter: brightness(0) invert(1);
}

.activity-action.danger .activity-action-icon {
  filter: brightness(0) saturate(100%) invert(34%) sepia(32%) saturate(1328%) hue-rotate(328deg) brightness(91%) contrast(87%);
}

.activity-action.disabled {
  opacity: 0.62;
}

.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 22, 20, 0.42);
}

.create-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 34rpx 28rpx 44rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #f7f8f4;
  box-shadow: 0 -24rpx 60rpx rgba(17, 24, 22, 0.18);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-kicker {
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 900;
}

.sheet-title {
  margin-top: 8rpx;
  color: #17211e;
  font-size: 38rpx;
  font-weight: 900;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #edf0ee;
  color: #4d5653;
  text-align: center;
  line-height: 54rpx;
  font-size: 42rpx;
}

.form-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 28rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #4d5653;
  font-size: 23rpx;
  font-weight: 800;
}

.field-input,
.field-picker {
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #17211e;
  border: 1rpx solid #e6ece8;
  font-size: 26rpx;
  line-height: 76rpx;
}

.sheet-tip {
  margin-top: 22rpx;
  color: #79827f;
  font-size: 23rpx;
  line-height: 1.45;
}

.form-submit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.form-submit-row .sheet-submit {
  width: 100%;
  min-width: 0;
  margin-top: 0;
}
