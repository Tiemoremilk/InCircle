.activities-page {
  padding-top: 24rpx;
}

.top-panel {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 58%, var(--theme-accent, #b8d966) 160%);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.top-panel::after {
  content: "";
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.eyebrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  line-height: 1.16;
  font-weight: 900;
}

.page-desc {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.create-btn {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 22rpx 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}

.activity-list {
  margin-top: 24rpx;
}

.activity-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.activity-main {
  flex: 1;
  min-width: 0;
}

.activity-type {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 800;
}

.label-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.activity-title {
  margin-top: 8rpx;
  color: #17211e;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.activity-meta {
  margin-top: 10rpx;
  color: #79827f;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.detail-item {
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: #f5f8f5;
}

.detail-value {
  color: #17211e;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-label {
  margin-top: 6rpx;
  color: #79827f;
  font-size: 20rpx;
}

.progress-block {
  margin-top: 24rpx;
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #edf0ee;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--theme-primary, #2f7d50), var(--theme-accent, #b8d966));
}

.progress-copy {
  margin-top: 10rpx;
  color: #4d5653;
  font-size: 23rpx;
}

.status-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.status-btn {
  height: 58rpx;
  border-radius: 12rpx;
  background: #eef2ef;
  color: #26312e;
  text-align: center;
  line-height: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status-btn.active {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.status-btn.disabled {
  opacity: 0.62;
}

.insight-box {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f7f3e8;
}

.insight-line {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 800;
}

.recap-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 800;
}

.recap-action {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: 44rpx;
}

.recap-action.danger {
  color: #b34a34;
}

.recap-action.disabled {
  opacity: 0.62;
}

.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 22, 20, 0.42);
}

.create-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 34rpx 28rpx 44rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #f7f8f4;
  box-shadow: 0 -24rpx 60rpx rgba(17, 24, 22, 0.18);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-kicker {
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 900;
}

.sheet-title {
  margin-top: 8rpx;
  color: #17211e;
  font-size: 38rpx;
  font-weight: 900;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #edf0ee;
  color: #4d5653;
  text-align: center;
  line-height: 54rpx;
  font-size: 42rpx;
}

.form-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 28rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #4d5653;
  font-size: 23rpx;
  font-weight: 800;
}

.field-input,
.field-picker {
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #17211e;
  border: 1rpx solid #e6ece8;
  font-size: 26rpx;
  line-height: 76rpx;
}

.sheet-tip {
  margin-top: 22rpx;
  color: #79827f;
  font-size: 23rpx;
  line-height: 1.45;
}

.form-submit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.form-submit-row .sheet-submit {
  width: 100%;
  min-width: 0;
  margin-top: 0;
}
