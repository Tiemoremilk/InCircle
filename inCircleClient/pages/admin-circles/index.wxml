<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>
<view class="page admin-list-page {{themeClass}}" wx:if="{{!loading}}">
  <view class="search-shell"><image src="/images/ui-icons/search.svg"></image><input adjust-position="{{true}}" cursor-spacing="24" value="{{searchText}}" placeholder="搜索圈子、圈主或入圈码" bindinput="onSearchInput" confirm-type="search" /><view wx:if="{{searchText}}" bindtap="clearSearch">清空</view></view>
  <scroll-view class="filter-strip" scroll-x show-scrollbar="{{false}}"><view class="filter-content"><view class="filter-chip motion-state {{item.activeClass}}" wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="selectStatus">{{item.label}}</view></view></scroll-view>
  <view class="result-count">{{total}} 个圈子</view>
  <view wx:if="{{circles.length}}">
    <view class="admin-circle-item {{circleIndex < 6 ? 'motion-list-item' : ''}}" wx:for="{{circles}}" wx:key="id" wx:for-index="circleIndex" style="animation-delay: {{circleIndex * 35}}ms;">
      <view class="circle-main-row" data-id="{{item.id}}" bindtap="openCircle"><view class="circle-copy"><view class="circle-name">{{item.name}}</view><view class="circle-meta">圈主 {{item.ownerName}} · {{item.memberText}} · {{item.activityText}}</view></view><view class="circle-status {{item.statusClass}}"><view class="status-dot"></view><text>{{item.statusText}}</text></view><view class="row-arrow">›</view></view>
      <view class="circle-action-bar">
        <view class="circle-action" data-id="{{item.id}}" bindtap="openCircle">查看设置</view>
        <view class="circle-action status-action {{busyId ? 'disabled' : ''}}" data-id="{{item.id}}" data-status="{{item.nextStatus}}" bindtap="toggleStatus">{{busyId === item.statusBusyId ? '处理中...' : item.statusActionText}}</view>
        <view class="circle-action delete-action {{busyId ? 'disabled' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="deleteCircle">{{busyId === item.deleteBusyId ? '删除中...' : '删除'}}</view>
      </view>
    </view>
  </view>
  <empty-state wx:else kind="search" icon="/images/ui-icons/search.svg" title="没有匹配的圈子" description="调整搜索词或状态筛选后再查看。" compact="{{true}}" />
  <view class="loading-more" wx:if="{{loadingMore}}">正在加载...</view>
</view>
<view class="page loading-page {{themeClass}}" wx:else><view class="loading-panel"><view class="loading-illustration"><view class="loading-card-line first"></view><view class="loading-card-line second"></view><view class="loading-card-line third"></view><view class="loading-card-mark"></view></view><view class="loading-text">正在读取平台圈子...</view><view class="loading-dots"><view></view><view></view><view></view></view></view></view>
<theme-dialog id="incircle-theme-dialog" />
