.admin-list-page{padding-top:20rpx}.search-shell{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:14rpx;height:82rpx;padding:0 20rpx;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.12));border-radius:14rpx;background:rgba(255,255,255,.96);box-shadow:0 8rpx 24rpx rgba(28,45,38,.06);box-sizing:border-box;backdrop-filter:blur(16rpx)}.search-shell image{width:30rpx;height:30rpx;opacity:.64}.search-shell input{min-width:0;height:100%;flex:1;font-size:25rpx}.search-shell view{color:var(--theme-primary,#2f7d50);font-size:22rpx;font-weight:700}.filter-strip{margin:18rpx 0 0}.filter-content{display:inline-flex;gap:12rpx;padding-right:24rpx}.filter-chip{display:flex;align-items:center;justify-content:center;height:58rpx;padding:0 24rpx;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.12));border-radius:10rpx;background:#fff;color:#67726e;font-size:23rpx;font-weight:700}.filter-chip.active{border-color:var(--theme-primary,#2f7d50);background:var(--theme-soft,#eaf5ed);color:var(--theme-primary-dark,#1c5638)}.result-count{margin:22rpx 2rpx 10rpx;color:#858e8b;font-size:22rpx}.admin-circle-item{margin-top:14rpx;overflow:hidden;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.1));border-radius:16rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(30,48,40,.05)}.circle-main-row{display:flex;align-items:center;gap:14rpx;padding:22rpx}.circle-copy{min-width:0;flex:1}.circle-name{overflow:hidden;color:#202b27;font-size:28rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.circle-meta{margin-top:7rpx;overflow:hidden;color:#7b8581;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.circle-status{display:flex;align-items:center;gap:7rpx;color:var(--theme-primary,#2f7d50);font-size:21rpx;font-weight:700}.circle-status.pill-red{color:#b34a34}.status-dot{width:9rpx;height:9rpx;border-radius:50%;background:currentColor}.row-arrow{color:#8d9692;font-size:34rpx}.circle-action-bar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1rpx solid #edf1ee}.circle-action{display:flex;align-items:center;justify-content:center;height:66rpx;color:#48534f;font-size:22rpx;font-weight:700}.circle-action+.circle-action{border-left:1rpx solid #edf1ee}.status-action{background:var(--theme-soft,#eef7f1);color:var(--theme-primary-dark,#1c5638)}.delete-action{background:#fff7f4;color:#b34a34}.loading-more{padding:28rpx;color:#8a9490;font-size:22rpx;text-align:center}.disabled{opacity:.5;pointer-events:none}
