.login-records-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: 40rpx;
  background: var(--theme-page-bg, #f3f8f5);
}

.records-toolbar {
  position: sticky;
  top: 0;
  z-index: 8;
  padding: 20rpx 0 14rpx;
  background: var(--theme-page-bg, #f3f8f5);
}

.search-shell {
  display: flex;
  align-items: center;
  gap: 13rpx;
  height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.12));
  border-radius: 14rpx;
  background: var(--theme-card-bg, #ffffff);
  box-shadow: 0 8rpx 22rpx var(--theme-soft-shadow, rgba(47, 125, 80, 0.06));
  box-sizing: border-box;
}

.search-shell > image {
  width: 29rpx;
  height: 29rpx;
  flex: 0 0 29rpx;
  opacity: 0.62;
  filter: var(--theme-icon-filter, none);
}

.search-shell input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #26312d;
  font-size: 24rpx;
}

.search-clear {
  flex: 0 0 auto;
  color: var(--theme-primary, #2f7d50);
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
}

.records-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 46rpx;
  padding: 10rpx 4rpx 0;
  color: #79837f;
  font-size: 19rpx;
  line-height: 1.3;
}

.records-summary > view {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.records-summary > view text:first-child {
  color: var(--theme-primary-dark, #1c5638);
  font-weight: 900;
}

.summary-divider {
  color: var(--theme-card-active-border, rgba(47, 125, 80, 0.24));
}

.records-summary > text {
  flex: 0 0 auto;
  color: var(--theme-primary, #2f7d50);
  font-weight: 800;
}

.records-list {
  display: grid;
  gap: 12rpx;
}

.login-record-card {
  overflow: hidden;
  padding: 20rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  border-radius: 16rpx;
  background: var(--theme-card-bg, #ffffff);
  box-shadow: 0 7rpx 20rpx var(--theme-soft-shadow, rgba(47, 125, 80, 0.05));
  box-sizing: border-box;
}

.login-record-card.current {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  background: linear-gradient(100deg, var(--theme-soft, #edf7f0) 0%, var(--theme-card-bg, #ffffff) 48%);
}

.record-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.record-device-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
  box-sizing: border-box;
}

.login-record-card.current .record-device-icon {
  border-color: var(--theme-card-border, rgba(47, 125, 80, 0.1));
  background: var(--theme-card-bg, #ffffff);
}

.record-device-icon image {
  width: 30rpx;
  height: 30rpx;
  filter: var(--theme-icon-filter, none);
}

.record-device-copy {
  min-width: 0;
  flex: 1;
}

.record-device-name {
  overflow: hidden;
  color: #1b2521;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-environment {
  margin-top: 6rpx;
  overflow: hidden;
  color: #747f7a;
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-side {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 9rpx;
  flex: 0 0 auto;
}

.record-status,
.record-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 68rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 900;
}

.record-status {
  background: #f0f3f1;
  color: #75807c;
}

.record-status.current,
.record-status.active {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
}

.record-action.danger {
  border: 1rpx solid rgba(179, 74, 52, 0.2);
  background: #fff4f0;
  color: #b34a34;
}

.record-action.disabled {
  opacity: 0.55;
}

.record-location {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
}

.record-location.empty {
  border-top-color: var(--theme-card-border, rgba(47, 125, 80, 0.1));
}

.record-location-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 11rpx;
  background: var(--theme-soft, #eaf5ed);
}

.record-location.recorded .record-location-icon {
  border-color: var(--theme-primary, #2f7d50);
  background: var(--theme-primary, #2f7d50);
}

.record-location-icon image {
  width: 22rpx;
  height: 22rpx;
  filter: var(--theme-icon-filter, none);
}

.record-location.recorded .record-location-icon image {
  filter: brightness(0) invert(1);
}

.record-location-copy {
  min-width: 0;
  flex: 1;
}

.record-location-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 30rpx;
}

.record-location-head view {
  color: #33403b;
  font-size: 19rpx;
  font-weight: 900;
}

.record-location-head text {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 16rpx;
  font-weight: 800;
}

.record-location.empty .record-location-head text {
  color: #858f8b;
}

.record-location-value {
  margin-top: 5rpx;
  color: #53605b;
  font-size: 19rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.record-location.empty .record-location-value {
  color: #89928e;
}

.record-location-detail {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5rpx 12rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.08));
  color: #7d8783;
  font-size: 17rpx;
  line-height: 1.35;
}

.record-coordinate {
  overflow-wrap: anywhere;
  font-family: Consolas, monospace;
  letter-spacing: 0;
}

.record-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 12rpx;
}

.record-meta view {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 6rpx;
  color: #87918d;
  font-size: 18rpx;
  line-height: 1.3;
}

.record-meta image {
  width: 19rpx;
  height: 19rpx;
  flex: 0 0 19rpx;
  opacity: 0.56;
  filter: var(--theme-icon-filter, none);
}

.records-error {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 112rpx;
  padding: 18rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  border-radius: 16rpx;
  background: var(--theme-card-bg, #ffffff);
  box-sizing: border-box;
}

.records-error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  border-radius: 13rpx;
  background: #fff3ef;
}

.records-error-icon image {
  width: 28rpx;
  height: 28rpx;
  filter: invert(37%) sepia(53%) saturate(960%) hue-rotate(328deg) brightness(93%) contrast(84%);
}

.records-error-copy {
  min-width: 0;
  flex: 1;
}

.records-error-copy view {
  color: #29332f;
  font-size: 23rpx;
  font-weight: 900;
}

.records-error-copy text {
  display: block;
  margin-top: 5rpx;
  color: #7e8884;
  font-size: 18rpx;
  line-height: 1.35;
}

.records-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50rpx;
  padding: 0 14rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 10rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 19rpx;
  font-weight: 800;
}
