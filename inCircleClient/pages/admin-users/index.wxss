.admin-users-page{padding-top:20rpx}.search-shell{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:14rpx;height:82rpx;padding:0 20rpx;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.12));border-radius:14rpx;background:rgba(255,255,255,.96);box-shadow:0 8rpx 24rpx rgba(28,45,38,.06);box-sizing:border-box;backdrop-filter:blur(16rpx)}.search-shell image{width:30rpx;height:30rpx;opacity:.64}.search-shell input{min-width:0;height:100%;flex:1;font-size:25rpx}.search-shell>view{color:var(--theme-primary,#2f7d50);font-size:22rpx;font-weight:700}.filter-strip{margin-top:18rpx}.filter-content{display:inline-flex;gap:12rpx;padding-right:24rpx}.filter-chip{display:flex;align-items:center;justify-content:center;height:58rpx;padding:0 24rpx;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.12));border-radius:10rpx;background:#fff;color:#67726e;font-size:23rpx;font-weight:700}.filter-chip.active{border-color:var(--theme-primary,#2f7d50);background:var(--theme-soft,#eaf5ed);color:var(--theme-primary-dark,#1c5638)}.result-count{margin:22rpx 2rpx 10rpx;color:#858e8b;font-size:22rpx}.user-row{display:flex;align-items:center;gap:16rpx;min-height:116rpx;margin-top:12rpx;padding:18rpx 20rpx;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.1));border-radius:14rpx;background:#fff;box-shadow:0 7rpx 20rpx rgba(30,48,40,.045);box-sizing:border-box}.user-avatar{width:72rpx;height:72rpx;flex-shrink:0;border-radius:50%;background:#eef2ef}.user-copy{min-width:0;flex:1}.user-name-line{display:flex;align-items:center;gap:9rpx}.user-name{overflow:hidden;color:#202b27;font-size:27rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.protected-badge{padding:5rpx 9rpx;border-radius:7rpx;background:var(--theme-soft,#eaf5ed);color:var(--theme-primary,#2f7d50);font-size:18rpx;font-weight:800}.user-account,.user-bind{margin-top:5rpx;overflow:hidden;color:#78827e;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.user-bind{color:#949c99}.user-side{display:flex;align-items:center;gap:10rpx}.user-status{font-size:21rpx;font-weight:800}.status-active{color:var(--theme-primary,#2f7d50)}.status-blocked,.status-deleted{color:#b34a34}.row-arrow{color:#919995;font-size:34rpx}.loading-more{padding:28rpx;color:#8a9490;font-size:22rpx;text-align:center}
