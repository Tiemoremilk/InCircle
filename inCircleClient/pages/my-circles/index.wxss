.all-circles-page { padding-top: 20rpx; }
.search-shell { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 14rpx; height: 82rpx; padding: 0 20rpx; border: 1rpx solid var(--theme-card-border, rgba(47,125,80,.12)); border-radius: 14rpx; background: rgba(255,255,255,.96); box-shadow: 0 8rpx 24rpx rgba(28,45,38,.06); box-sizing: border-box; backdrop-filter: blur(16rpx); }
.search-icon { width: 30rpx; height: 30rpx; opacity: .64; }
.search-input { min-width: 0; height: 100%; flex: 1; color: #24302c; font-size: 25rpx; }
.search-clear { color: var(--theme-primary,#2f7d50); font-size: 22rpx; font-weight: 700; }
.list-summary { display: flex; justify-content: space-between; align-items: center; margin: 26rpx 2rpx 12rpx; color: #737e7a; font-size: 22rpx; }
.circle-item { margin-top: 14rpx; padding: 24rpx; border: 1rpx solid var(--theme-card-border,rgba(47,125,80,.1)); border-radius: 16rpx; background: var(--theme-card-bg,#fff); box-shadow: 0 8rpx 22rpx rgba(30,48,40,.05); }
.circle-item.active { border-color: var(--theme-card-active-border,rgba(47,125,80,.28)); background: var(--theme-soft,#eef7f1); }
.circle-head { display: flex; align-items: flex-start; gap: 16rpx; }
.circle-copy { min-width: 0; flex: 1; }
.circle-name { overflow: hidden; color: #202b27; font-size: 28rpx; line-height: 1.3; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.circle-slogan { display: -webkit-box; margin-top: 7rpx; overflow: hidden; color: #76817d; font-size: 23rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.circle-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; color: #7d8783; font-size: 21rpx; }
.circle-actions { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(0,1fr); gap: 14rpx; margin-top: 19rpx; }
.enter-button,.settings-button { height: 68rpx; min-width: 0; margin: 0; border-radius: 10rpx; font-size: 24rpx; box-sizing: border-box; }
.settings-button { display: flex; align-items: center; justify-content: center; gap: 8rpx; border: 1rpx solid var(--theme-card-border,rgba(47,125,80,.14)); background: #fff; color: #45504c; font-weight: 700; }
.settings-button image { width: 27rpx; height: 27rpx; opacity: .7; }
.loading-more,.list-end { padding: 28rpx 0 10rpx; color: #8a9490; font-size: 22rpx; text-align: center; }
.disabled { opacity: .55; pointer-events: none; }
