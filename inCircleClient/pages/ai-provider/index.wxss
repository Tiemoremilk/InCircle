@import "../../ai-ui.wxss";

.provider-page {
  overflow-x: hidden;
}

.provider-intro {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  gap: 16rpx;
  padding: 4rpx 4rpx 16rpx;
}

.provider-intro-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: linear-gradient(145deg, var(--theme-primary, #2f7d50), var(--theme-primary-dark, #1c5638));
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
}

.provider-intro-main {
  flex: 1;
  min-width: 0;
}

.provider-intro-title {
  color: #202b27;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
}

.provider-intro-copy {
  margin-top: 4rpx;
  color: #858e8b;
  font-size: 22rpx;
}

.provider-mode,
.provider-connected,
.provider-option-state {
  color: var(--theme-primary, #2f7d50);
  font-size: 22rpx;
  font-weight: 750;
  white-space: nowrap;
}

.provider-mode {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 7rpx;
  background: var(--theme-soft, #eaf5ed);
}

.provider-select-section {
  margin-top: 12rpx;
}

.provider-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 10rpx;
}

.provider-option {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  min-width: 0;
  padding: 13rpx 14rpx;
  border: 1rpx solid rgba(73, 91, 83, 0.11);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 7rpx 20rpx rgba(35, 54, 46, 0.035);
  box-sizing: border-box;
}

.provider-option.configured {
  background: #f8faf9;
}

.provider-option.selected {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.28));
  background: var(--theme-soft, #eaf5ed);
}

.provider-option:active {
  opacity: 0.82;
  transform: scale(0.985);
}

.provider-option-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #f0f4f2;
  color: #66716d;
  font-size: 20rpx;
  font-weight: 900;
}

.provider-option.selected .provider-option-mark,
.provider-option-mark.selected {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.provider-option-main {
  flex: 1;
  min-width: 0;
}

.provider-option-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
  width: 100%;
}

.provider-option-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #29342f;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.provider-option-state {
  margin-left: 8rpx;
  flex-shrink: 0;
  padding: 4rpx 6rpx;
  border-radius: 6rpx;
  background: var(--theme-soft, #eaf5ed);
  font-size: 19rpx;
  line-height: 1.2;
}

.provider-option-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: var(--theme-primary, #2f7d50);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.2), 0 4rpx 10rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
}

.provider-option-check-icon {
  display: block;
  width: 18rpx;
  height: 18rpx;
}

.provider-locked {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  padding: 15rpx 18rpx;
  gap: 14rpx;
}

.provider-locked .provider-option-main {
  flex: 1;
}

.provider-connected {
  flex-shrink: 0;
  padding: 6rpx 9rpx;
  border-radius: 7rpx;
  background: var(--theme-soft, #eaf5ed);
}

.advanced-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  gap: 18rpx;
  border-top: 1rpx solid #edf1ef;
}

.advanced-title {
  color: #34403b;
  font-size: 25rpx;
  font-weight: 750;
}

.advanced-copy {
  margin-top: 4rpx;
  color: #89918e;
  font-size: 22rpx;
}

.advanced-chevron {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  transition: transform 180ms ease;
}

.advanced-chevron::before {
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 11rpx;
  height: 11rpx;
  border-right: 3rpx solid var(--theme-primary, #2f7d50);
  border-bottom: 3rpx solid var(--theme-primary, #2f7d50);
  content: "";
  transform: rotate(45deg);
}

.advanced-chevron.open {
  transform: rotate(180deg);
}

.advanced-content {
  padding-top: 2rpx;
}

.ai-ui-inline-status.working .ai-ui-status-mark {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.provider-save {
  width: 100%;
  height: 80rpx;
  margin-top: 24rpx;
  font-size: 27rpx;
}

.ai-manage-error {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  font-size: 24rpx;
  font-weight: 900;
}

.error-title {
  margin-top: 22rpx;
  color: #26312d;
  font-size: 28rpx;
  font-weight: 800;
}

.error-copy {
  max-width: 560rpx;
  margin-top: 9rpx;
  color: #7f8985;
  font-size: 22rpx;
  line-height: 1.5;
}

.error-action {
  width: 250rpx;
  margin-top: 24rpx;
}

@media (prefers-reduced-motion: reduce) {
  .advanced-chevron,
  .provider-option {
    transition: none;
  }
}
