.vote-detail-page {
  padding-top: 24rpx;
  padding-bottom: var(--incircle-fixed-action-reserve, 228rpx);
}

.vote-hero {
  padding: 34rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 70%, var(--theme-accent, #b8d966) 160%);
  color: #ffffff;
  box-shadow: 0 24rpx 54rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.hero-row,
.option-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.vote-type {
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  font-weight: 800;
}

.vote-title {
  margin-top: 22rpx;
  font-size: 44rpx;
  line-height: 1.16;
  font-weight: 900;
}

.vote-meta {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.45;
}

.vote-rule-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.vote-rule-chip {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #fff2cf;
  font-size: 22rpx;
  font-weight: 900;
}

.result-box {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #fff2cf;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
}

.result-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.result-copy {
  margin-top: 8rpx;
  color: #fff2cf;
  white-space: pre-wrap;
}

.location-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.location-title {
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 900;
}

.location-copy {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.4;
}

.location-action {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  text-align: center;
  line-height: 52rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.option-card,
.feature-card,
.rule-card {
  padding: 28rpx;
}

.option-card {
  padding: 18rpx;
}

.silent-card {
  padding: 28rpx;
}

.option-row {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #edf0ee;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.86);
}

.option-row:first-child {
  margin-top: 0;
}

.option-row:last-child {
  padding-bottom: 22rpx;
}

.option-row.vetoed {
  opacity: 0.58;
}

.option-row.selected {
  background: var(--theme-soft, #eaf5ed);
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.24));
}

.option-row.disabled {
  opacity: 0.68;
}

.option-title {
  color: #17211e;
  font-size: 29rpx;
  font-weight: 900;
}

.option-selected-badge {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  vertical-align: middle;
}

.option-percent {
  color: var(--theme-primary, #2f7d50);
  font-size: 32rpx;
  font-weight: 900;
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #edf0ee;
  overflow: hidden;
  margin-top: 14rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-fill.primary {
  background: linear-gradient(90deg, var(--theme-primary, #2f7d50), var(--theme-accent, #b8d966));
}

.progress-fill.amber {
  background: var(--theme-accent, #b8d966);
}

.progress-fill.blue {
  background: linear-gradient(90deg, var(--theme-primary-dark, #1c5638), var(--theme-primary, #2f7d50));
}

.voter-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.voter-pill {
  max-width: 220rpx;
  height: 52rpx;
  padding: 0 14rpx 0 6rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.voter-pill text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voter-avatar {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
}

.voter-empty {
  color: #98a19e;
  font-size: 22rpx;
  line-height: 52rpx;
}

.option-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.veto-btn {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffe9e3;
  color: #b34a34;
  line-height: 48rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.veto-btn.disabled {
  opacity: 0.7;
}

.silent-title {
  color: #17211e;
  font-size: 30rpx;
  font-weight: 900;
}

.silent-copy,
.feature-copy,
.rule-copy {
  margin-top: 12rpx;
  color: #79827f;
  font-size: 24rpx;
  line-height: 1.5;
}

.rule-line {
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0ee;
}

.rule-line:first-child {
  padding-top: 0;
  border-top: 0;
}

.rule-line:last-child {
  padding-bottom: 0;
}

.rule-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 27rpx;
  font-weight: 900;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.feature-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
}

.sticky-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 248, 244, 0.94);
  border-top: 1rpx solid #e6ece8;
  backdrop-filter: blur(18rpx);
}

.sticky-actions.has-delete {
  grid-template-columns: 0.9fr 1fr 1fr;
}

.danger-btn {
  min-width: 0;
  height: 76rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #fff3ef;
  color: #b34a34;
  text-align: center;
  line-height: 76rpx;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.danger-btn.disabled {
  opacity: 0.62;
}

.share-btn {
  border: 0;
}
