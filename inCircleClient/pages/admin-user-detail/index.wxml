<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>

<view class="page admin-user-page {{themeClass}}" wx:if="{{!loading && user}}">
  <view class="user-identity motion-hero"><image class="user-avatar" src="{{user.avatar}}" mode="aspectFill"></image><view class="identity-copy"><view class="identity-name">{{user.nickName}}</view><view class="identity-account">{{user.accountName || '未设置账号'}}</view></view><view class="status-badge motion-state status-{{user.status}}">{{user.statusText}}</view></view>
  <view class="detail-section"><view class="section-title">账号信息</view><view class="detail-rows"><view class="detail-row"><text>手机号</text><text>{{user.phone || '未填写'}}</text></view><view class="detail-row"><text>微信状态</text><text>{{user.wechatBound ? '已绑定' : '未绑定'}}</text></view><view class="detail-row"><text>注册时间</text><text>{{user.createdAtText}}</text></view><view class="detail-row"><text>最近登录</text><text>{{user.lastLoginAtText}}</text></view><view class="detail-row" wx:if="{{user.status === 'blocked'}}"><text>封禁时间</text><text>{{user.blockedAtText}}</text></view></view></view>
  <view class="detail-section"><view class="section-head"><view class="section-title">圈子关系</view><view class="section-meta">{{circles.length}} 条</view></view><view wx:if="{{circles.length}}"><view class="relation-row {{circleIndex < 6 ? 'motion-list-item' : ''}}" wx:for="{{circles}}" wx:key="membershipId" wx:for-index="circleIndex" data-id="{{item.id}}" bindtap="openCircle" style="animation-delay: {{circleIndex * 35}}ms;"><view class="relation-copy"><view class="relation-name">{{item.name}}</view><view class="relation-meta">{{item.role}} · {{item.relationText}} · {{item.joinedAtText}}</view></view><view class="row-arrow">›</view></view></view><empty-state wx:else kind="circle" icon="/images/ui-icons/layers.svg" title="没有圈子关系" description="该用户尚未加入任何有效圈子。" embedded="{{true}}" compact="{{true}}" /></view>
  <view class="detail-section account-actions" wx:if="{{user.canManage}}"><view class="section-title">账号操作</view><view class="account-action status-action" bindtap="toggleBlocked"><view><view class="action-title">{{user.status === 'blocked' ? '解除封禁' : '封禁用户'}}</view><view class="action-copy">{{user.status === 'blocked' ? '恢复账号登录资格' : '立即撤销登录并停止访问'}}</view></view><text>{{busyAction === 'status' ? '处理中' : '›'}}</text></view><view class="account-action {{!user.wechatBound ? 'disabled' : ''}}" bindtap="unbindWechat"><view><view class="action-title">解绑微信</view><view class="action-copy">保留账号密码与圈子数据</view></view><text>{{busyAction === 'unbind' ? '处理中' : '›'}}</text></view><view class="account-action delete-action" bindtap="deleteUser"><view><view class="action-title">物理删除用户</view><view class="action-copy">同时删除 {{deleteImpact.ownedCircleCount}} 个名下圈子</view></view><text>{{busyAction === 'delete' ? '删除中' : '›'}}</text></view></view>
  <view class="protected-note" wx:else>当前账号受保护，不能执行封禁、解绑或删除。</view>
</view>
<view class="page loading-page {{themeClass}}" wx:else><view class="loading-panel"><view class="loading-illustration"><view class="loading-card-line first"></view><view class="loading-card-line second"></view><view class="loading-card-line third"></view><view class="loading-card-mark"></view></view><view class="loading-text">正在读取用户详情...</view><view class="loading-dots"><view></view><view></view><view></view></view></view></view>
<theme-dialog id="incircle-theme-dialog" />
