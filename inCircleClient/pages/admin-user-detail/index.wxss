.admin-user-page{padding-top:24rpx;padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}.user-identity{display:flex;align-items:center;gap:18rpx;padding:26rpx;border:1rpx solid var(--theme-card-border,rgba(47,125,80,.1));border-radius:16rpx;background:linear-gradient(145deg,var(--theme-soft,#eef7f1),#fff)}.user-avatar{width:92rpx;height:92rpx;flex-shrink:0;border:3rpx solid #fff;border-radius:50%;box-shadow:0 8rpx 20rpx rgba(28,48,39,.12)}.identity-copy{min-width:0;flex:1}.identity-name{overflow:hidden;color:#1d2824;font-size:34rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.identity-account{margin-top:7rpx;color:#74807b;font-size:23rpx}.status-badge{font-size:22rpx;font-weight:800}.status-active{color:var(--theme-primary,#2f7d50)}.status-blocked,.status-deleted{color:#b34a34}.detail-section{margin-top:30rpx}.section-head{display:flex;align-items:center;justify-content:space-between}.section-title{margin-bottom:13rpx;color:#26312d;font-size:28rpx;font-weight:800}.section-meta{margin-bottom:13rpx;color:#858e8b;font-size:21rpx}.detail-rows,.relation-row,.account-actions{border:1rpx solid var(--theme-card-border,rgba(47,125,80,.1));border-radius:14rpx;background:#fff}.detail-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;min-height:76rpx;padding:0 22rpx;color:#737d79;font-size:23rpx}.detail-row+.detail-row{border-top:1rpx solid #edf1ee}.detail-row text:last-child{min-width:0;color:#27322e;font-weight:700;text-align:right}.relation-row{display:flex;align-items:center;gap:16rpx;min-height:92rpx;margin-top:10rpx;padding:16rpx 20rpx;box-sizing:border-box}.relation-copy{min-width:0;flex:1}.relation-name{overflow:hidden;color:#25302c;font-size:26rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.relation-meta{margin-top:6rpx;overflow:hidden;color:#7d8783;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.row-arrow{color:var(--theme-primary,#2f7d50);font-size:34rpx}.account-actions{overflow:hidden}.account-actions>.section-title{padding:22rpx 22rpx 6rpx}.account-action{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:88rpx;padding:14rpx 22rpx;border-top:1rpx solid #edf1ee;box-sizing:border-box}.action-title{color:#28332f;font-size:25rpx;font-weight:800}.action-copy{margin-top:5rpx;color:#838c88;font-size:21rpx}.account-action>text{color:var(--theme-primary,#2f7d50);font-size:25rpx}.account-action.delete-action .action-title,.account-action.delete-action>text{color:#b34a34}.protected-note{margin-top:28rpx;padding:20rpx;border-radius:12rpx;background:#f2f4f3;color:#7b8581;font-size:22rpx;text-align:center}.disabled{opacity:.5;pointer-events:none}
