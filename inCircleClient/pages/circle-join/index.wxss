.join-page {
  padding-top: 24rpx;
}

.join-hero {
  padding: 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 70%, var(--theme-accent, #b8d966) 160%);
  box-shadow: 0 22rpx 50rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 900;
}

.hero-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 27rpx;
  line-height: 1.5;
}

.circle-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: var(--theme-accent, #b8d966);
  color: var(--theme-primary-dark, #1c5638);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.hero-icon {
  width: 48rpx;
  height: 48rpx;
}

.join-card,
.preview-card {
  padding: 28rpx;
}

.section-title.with-icon {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #4d5653;
  font-size: 24rpx;
  font-weight: 800;
}

.field-input {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6ece8;
  border-radius: 14rpx;
  background: #ffffff;
  color: #17211e;
  font-size: 30rpx;
  line-height: 82rpx;
  font-weight: 900;
}

.invite-code {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #f5f8f5;
  border: 1rpx dashed var(--theme-card-active-border, rgba(47, 125, 80, 0.28));
  text-align: center;
}

.invite-code.empty {
  opacity: 0.72;
}

.invite-text {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 44rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.invite-meta {
  margin-top: 12rpx;
  color: #79827f;
  font-size: 23rpx;
  font-weight: 800;
}

.join-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.hint {
  margin-top: 18rpx;
  color: #79827f;
  font-size: 23rpx;
  line-height: 1.5;
}

.preview-row {
  padding: 22rpx 0;
  border-top: 1rpx solid #edf0ee;
}

.preview-row:first-of-type {
  border-top: none;
}

.preview-title {
  color: #17211e;
  font-size: 28rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.back-link {
  margin-top: 22rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
}

.back-link.disabled {
  opacity: 0.56;
}
