<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>
<view class="page join-page {{themeClass}}" wx:if="{{!loading}}">
  <view class="join-hero card motion-hero">
    <view class="hero-row">
      <view>
        <view class="eyebrow">邀请码加入</view>
        <view class="hero-title">确认这是你的熟人圈。</view>
      </view>
      <view class="circle-mark motion-theme-mark">
        <image class="hero-icon" src="/images/ui-icons/add.png"></image>
      </view>
    </view>
    <view class="hero-copy">输入圈子口令或打开微信群分享卡片，加入后才可查看活动、账单和成员卡。</view>
  </view>

  <view class="section">
    <view class="join-card card">
      <view class="join-card-head">
        <view class="join-heading-icon">
          <image src="/images/ui-icons/key-round.svg" mode="aspectFit"></image>
        </view>
        <view class="join-heading-copy">
          <view class="join-heading-title">输入邀请码</view>
          <view class="join-heading-note">8 位邀请码，区分大小写</view>
        </view>
      </view>
      <view class="field invite-input-field">
        <input class="field-input" adjust-position="{{true}}" cursor-spacing="24" value="{{joinCode}}" maxlength="8" placeholder="例如 Ab1#￥%&amp;2" bindinput="onCodeInput" />
      </view>

      <view class="invite-code" wx:if="{{hasPreview}}">
        <view class="invite-text">{{joinCode}}</view>
        <view class="invite-meta invite-meta-found">
          <text class="invite-circle-name">{{circle.name}}</text>
          <view class="invite-meta-dot"></view>
          <text>圈子已确认</text>
        </view>
      </view>
      <view class="invite-code empty" wx:else>
        <view class="invite-text">--------</view>
        <view class="invite-meta">输入后会显示匹配到的圈子</view>
      </view>

      <view class="join-actions">
        <view class="primary-btn {{joining || previewing ? 'disabled' : ''}}" bindtap="joinCircle">
          <text>{{joinButtonText}}</text>
        </view>
        <view class="ghost-btn {{joining || previewing ? 'disabled' : ''}}" bindtap="previewCode">
          <text>{{previewing ? "预览中..." : "预览"}}</text>
        </view>
      </view>
      <view class="hint">加入后默认为成员，圈主负责维护圈内秩序。</view>
    </view>
  </view>

  <view class="section" wx:if="{{hasPreview}}">
    <view class="preview-card card motion-section">
      <view class="preview-card-head">
        <view class="preview-heading">
          <view class="preview-heading-icon">
            <image src="/images/ui-icons/eye.svg" mode="aspectFit"></image>
          </view>
          <view class="preview-heading-copy">
            <view class="preview-heading-title">加入前可见</view>
            <view class="preview-heading-note">确认圈子的公开信息</view>
          </view>
        </view>
        <view class="preview-status {{circle.disabledClass}}">
          <view class="preview-status-dot"></view>
          <text>{{circle.statusText}}</text>
        </view>
      </view>
      <view class="preview-card-body">
        <view class="preview-notice">
          <view class="preview-label">圈子公告</view>
          <view class="preview-notice-copy">{{circle.notice || "圈主暂未发布公告"}}</view>
        </view>
        <view class="preview-metrics">
          <view class="preview-metric">
            <view class="preview-metric-value">{{circle.memberCount}}</view>
            <view class="preview-metric-label">圈内成员</view>
          </view>
          <view class="preview-metric">
            <view class="preview-metric-value">{{circle.monthlyActivityCount}}</view>
            <view class="preview-metric-label">本月约局</view>
          </view>
          <view class="preview-metric">
            <view class="preview-metric-value">{{circle.unsettledCount}}</view>
            <view class="preview-metric-label">待结清</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="back-link {{joining || previewing ? 'disabled' : ''}}" bindtap="openMyCircles">返回我的圈子</view>
</view>

<view class="page loading-page {{themeClass}}" wx:else>
  <view class="loading-panel">
    <view class="loading-illustration">
      <view class="loading-card-line first"></view>
      <view class="loading-card-line second"></view>
      <view class="loading-card-line third"></view>
      <view class="loading-card-mark"></view>
    </view>
    <view class="loading-text">正在读取邀请信息...</view>
    <view class="loading-dots"><view></view><view></view><view></view></view>
  </view>
</view>
<theme-dialog id="incircle-theme-dialog" />
