.tools-page {
  padding-top: 20rpx;
}

.tool-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 70%, var(--theme-accent, #b8d966) 160%);
  color: #ffffff;
  box-shadow: 0 22rpx 50rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
  font-weight: 800;
}

.page-title {
  margin-top: 10rpx;
  max-width: 510rpx;
  font-size: 36rpx;
  line-height: 1.22;
  font-weight: 900;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 520rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.hero-count {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(15, 22, 20, 0.14);
}

.hero-icon {
  width: 44rpx;
  height: 44rpx;
  filter: var(--theme-icon-filter);
}

.tools-page .hero-count {
  background: rgba(255, 255, 255, 0.9);
  color: var(--theme-primary-dark, #1c5638);
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin: 24rpx 0 28rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(24, 33, 31, 0.06);
}

.segment {
  height: 64rpx;
  border-radius: 12rpx;
  color: #626c68;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.segment-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.segment.active {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.tools-page .section-head {
  margin-bottom: 18rpx;
}

.tools-page .section-title {
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 900;
}

.tools-page .section-action {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 900;
}

.bill-card,
.vote-card,
.decision-card,
.checkin-card {
  padding: 24rpx;
  margin-bottom: 22rpx;
}

.tool-card {
  overflow: hidden;
  border-color: rgba(47, 125, 80, 0.07);
  box-shadow: 0 12rpx 30rpx rgba(47, 125, 80, 0.07);
}

.tool-card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.tool-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: var(--theme-soft, #eaf5ed);
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.12));
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-card-icon {
  width: 36rpx;
  height: 36rpx;
  filter: var(--theme-icon-filter);
}

.tool-card-main {
  flex: 1;
  min-width: 0;
}

.tool-kicker {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  font-size: 21rpx;
  line-height: 38rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tool-subtitle {
  margin-top: 7rpx;
  color: #6f7975;
  font-size: 24rpx;
  line-height: 1.38;
  font-weight: 700;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.vote-card .card-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.checkin-card .tool-label {
  color: var(--theme-primary, #2f7d50);
}

.card-title {
  margin-top: 8rpx;
  color: #17211e;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.label-red,
.label-blue,
.label-green {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.label-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.section-title.with-icon {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  filter: var(--theme-icon-filter);
}

.label-red {
  color: #b34a34;
}

.label-blue {
  color: var(--theme-primary, #2f7d50);
}

.label-green {
  color: var(--theme-primary, #2f7d50);
}

.bill-amount {
  flex-shrink: 0;
  min-width: 112rpx;
  max-width: 174rpx;
  height: 56rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page.tools-page .tool-card-head .bill-amount {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.tool-stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.tool-stat-item {
  min-height: 78rpx;
  padding: 13rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(246, 248, 246, 0.9);
  box-sizing: border-box;
}

.tool-stat-label {
  color: #8a9490;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
}

.tool-stat-value {
  margin-top: 8rpx;
  color: #25302e;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bill-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.bill-meta view {
  padding: 16rpx 10rpx;
  border-radius: 12rpx;
  background: #f5f8f5;
  color: #4d5653;
  font-size: 22rpx;
  line-height: 1.35;
}

.punchline {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 800;
}

.debtor-row,
.decision-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.transfer-list {
  margin-top: 18rpx;
  border-top: 1rpx solid #edf0ee;
}

.transfer-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 16rpx;
  color: #4d5653;
  font-size: 24rpx;
}

.transfer-item text:first-child {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transfer-item text:last-child {
  flex-shrink: 0;
  font-weight: 900;
  color: var(--theme-primary-dark, #1c5638);
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-row.three-actions {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.action-row.four-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.action-row.single-action {
  grid-template-columns: minmax(0, 1fr);
}

.small {
  height: 60rpx;
  font-size: 23rpx;
  line-height: 60rpx;
}

.action-row .primary-btn,
.action-row .ghost-btn,
.action-row .danger-btn {
  min-width: 0;
  padding: 0 12rpx;
  white-space: nowrap;
  overflow: hidden;
}

.danger-btn {
  border-radius: 8rpx;
  background: #fff3ef;
  color: #b34a34;
  text-align: center;
  font-weight: 900;
  box-sizing: border-box;
}

.action-row.single-action .danger-btn {
  background: rgba(179, 74, 52, 0.08);
}

.danger-btn.disabled {
  opacity: 0.62;
}

.share-btn {
  border: 0;
}

.option-item.disabled {
  opacity: 0.72;
}

.option-item {
  margin-top: 12rpx;
}

.option-item.selected {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  background: var(--theme-soft, #eaf5ed);
}

.option-card {
  padding: 16rpx 17rpx;
  border-radius: 16rpx;
  background: #f7f9f7;
  border: 1rpx solid rgba(47, 125, 80, 0.06);
}

.option-selected-text {
  color: var(--theme-primary, #2f7d50);
  font-weight: 900;
}

.option-head,
.checkin-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: #4d5653;
  font-size: 23rpx;
  font-weight: 800;
}

.option-name {
  flex: 1;
  min-width: 0;
  color: #25302e;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.option-count {
  flex-shrink: 0;
  max-width: 148rpx;
  color: #66716c;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #edf0ee;
  overflow: hidden;
  margin-top: 12rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--theme-primary, #2f7d50), var(--theme-accent, #b8d966));
}

.progress-fill.blue {
  background: linear-gradient(90deg, var(--theme-primary-dark, #1c5638), var(--theme-primary, #2f7d50));
}

.voter-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.voter-strip.compact {
  gap: 0;
}

.voter-strip.compact .voter-avatar {
  margin-right: -10rpx;
  border: 2rpx solid #ffffff;
}

.voter-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--theme-soft, #eaf5ed);
}

.silent-line {
  margin-top: 16rpx;
  padding: 13rpx 15rpx;
  border-radius: 14rpx;
  background: #f7f9f7;
  color: #6f7975;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 700;
}

.vote-summary-preview {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 23rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.decision-chip {
  max-width: 100%;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: #4d5653;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tool-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9rpx;
  margin-top: 16rpx;
}

.tool-info-chip {
  max-width: 100%;
  height: 40rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  background: #f3f6f3;
  color: #5d6764;
  line-height: 40rpx;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.decision-result {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 800;
  white-space: pre-line;
}

.rule-toggle-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.rule-toggle {
  height: 70rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e6ece8;
  color: #4d5653;
  text-align: center;
  line-height: 70rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.rule-toggle.active {
  background: var(--theme-primary, #2f7d50);
  border-color: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.wheel-mark {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 92rpx;
  padding: 0 12rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #ffffff 0%, var(--theme-accent, #b8d966) 52%, var(--theme-primary, #2f7d50) 125%);
  color: var(--theme-primary-dark, #1c5638);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.15;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
}

.decision-card .card-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.decision-card .muted {
  margin-top: 8rpx;
  color: #6f7975;
  font-size: 23rpx;
  line-height: 1.38;
  font-weight: 700;
}

.checkin-state {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 104rpx;
  min-height: 44rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: #64706b;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 900;
  box-sizing: border-box;
}

.checkin-state.is-complete {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.checkin-state-dot {
  width: 8rpx;
  height: 8rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.72;
}

.checkin-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 18rpx;
  color: #5f6a66;
  font-size: 23rpx;
  line-height: 1.3;
  font-weight: 900;
}

.checkin-bottom {
  align-items: flex-start;
  margin-top: 18rpx;
}

.checkin-support {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 9rpx;
}

.checkin-bottom .primary-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 0 18rpx;
}

.tool-card-head .pill {
  max-width: 132rpx;
  min-height: 42rpx;
  padding: 0 15rpx;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 22, 20, 0.42);
}

.create-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 34rpx 28rpx 44rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #f7f8f4;
  box-shadow: 0 -24rpx 60rpx rgba(17, 24, 22, 0.18);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.sheet-kicker {
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 900;
}

.sheet-title {
  margin-top: 8rpx;
  color: #17211e;
  font-size: 38rpx;
  font-weight: 900;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #edf0ee;
  color: #4d5653;
  text-align: center;
  line-height: 54rpx;
  font-size: 42rpx;
}

.field {
  margin-top: 18rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #4d5653;
  font-size: 23rpx;
  font-weight: 800;
}

.field-help {
  margin-top: 10rpx;
  color: #79827f;
  font-size: 22rpx;
  line-height: 1.45;
}

.field-input,
.field-picker,
.field-textarea {
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #17211e;
  border: 1rpx solid #e6ece8;
  font-size: 26rpx;
  line-height: 76rpx;
}

.field-textarea {
  height: 180rpx;
  padding-top: 18rpx;
  line-height: 1.45;
}

.member-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-chip {
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e6ece8;
  color: #4d5653;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.member-chip.active {
  background: var(--theme-primary, #2f7d50);
  border-color: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.vote-location-field {
  margin-top: 18rpx;
}

.location-card {
  padding: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--theme-soft, #eaf5ed) 0%, #ffffff 100%);
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
}

.location-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.location-card-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 900;
}

.location-card-copy {
  margin-top: 6rpx;
  color: #79827f;
  font-size: 22rpx;
  line-height: 1.4;
}

.location-status {
  flex-shrink: 0;
  min-width: 76rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #79827f;
  text-align: center;
  line-height: 42rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.location-status.active {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.location-input {
  border-color: rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 22rpx rgba(47, 125, 80, 0.06);
}

.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  min-height: 76rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.2));
}

.location-picker-main {
  flex: 1;
  min-width: 0;
}

.location-picker-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 900;
}

.location-picker-copy {
  margin-top: 6rpx;
  color: #79827f;
  font-size: 22rpx;
  line-height: 1.4;
}

.location-picker-action {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  text-align: center;
  line-height: 56rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.tools-page .location-picker-action {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.sheet-tip {
  margin-top: 22rpx;
  color: #79827f;
  font-size: 23rpx;
  line-height: 1.45;
}

.form-submit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.form-submit-row .sheet-submit {
  width: 100%;
  min-width: 0;
  margin-top: 0;
}

.create-sheet > .sheet-submit {
  margin-top: 24rpx;
}
