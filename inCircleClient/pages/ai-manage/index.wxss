.ai-manage-page {
  padding-top: 20rpx;
  overflow-x: hidden;
}

.ai-overview {
  position: relative;
  overflow: hidden;
  padding: 28rpx 28rpx 0;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 16rpx;
  background: linear-gradient(145deg, #ffffff 0%, #ffffff 58%, var(--theme-soft, #eaf5ed) 145%);
  box-shadow: 0 12rpx 34rpx rgba(34, 56, 47, 0.07);
}

.ai-overview::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 5rpx;
  background: linear-gradient(90deg, var(--theme-primary, #2f7d50), var(--theme-accent, #b8d966));
  content: "";
}

.overview-head,
.provider-head,
.model-summary,
.panel-heading,
.surface-label-row,
.field-label-line,
.quota-heading,
.output-limit-row,
.report-head,
.ai-privacy-note {
  display: flex;
  align-items: center;
}

.overview-head {
  gap: 20rpx;
}

.assistant-badge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 16rpx;
  background: linear-gradient(145deg, var(--theme-primary, #2f7d50), var(--theme-primary-dark, #1c5638));
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.assistant-signal {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 15rpx;
  height: 15rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #2ead70;
  animation: ai-signal 3.4s ease-in-out infinite;
}

.overview-main,
.panel-heading-main,
.provider-main,
.model-main,
.empty-main,
.output-limit-main {
  flex: 1;
  min-width: 0;
}

.overview-title {
  overflow: hidden;
  color: #19231f;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7b8581;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 15rpx;
  border: 1rpx solid #e5e9e7;
  border-radius: 999rpx;
  background: #f5f7f6;
  color: #7b8481;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #a5adaa;
}

.status-chip.active {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.2));
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
}

.status-chip.active .status-dot {
  background: var(--theme-primary, #2f7d50);
}

.status-chip.pending {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.2));
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
}

.status-chip.pending .status-dot {
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid var(--theme-primary, #2f7d50);
  background: transparent;
}

.overview-note {
  margin-top: 20rpx;
  color: #66716d;
  font-size: 24rpx;
  line-height: 1.5;
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22rpx;
  border-top: 1rpx solid rgba(82, 101, 93, 0.1);
}

.overview-stat {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: 110rpx;
  padding: 16rpx 8rpx;
}

.overview-stat + .overview-stat::before {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 1rpx;
  background: rgba(82, 101, 93, 0.1);
  content: "";
}

.overview-stat-value {
  max-width: 100%;
  overflow: hidden;
  color: var(--theme-primary-dark, #1c5638);
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-stat-label {
  margin-top: 6rpx;
  color: #818a87;
  font-size: 22rpx;
  white-space: nowrap;
}

.compact-section {
  margin-top: 28rpx;
}

.panel-heading {
  justify-content: space-between;
  min-height: 64rpx;
  margin: 0 4rpx 16rpx;
  gap: 20rpx;
}

.panel-title {
  color: #19231f;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
}

.panel-caption {
  margin-top: 5rpx;
  color: #858e8b;
  font-size: 22rpx;
  line-height: 1.35;
}

.heading-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 10rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 750;
}

.heading-action-plus {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}

.heading-action-plus::before,
.heading-action-plus::after {
  position: absolute;
  top: 10rpx;
  left: 2rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.heading-action-plus::after {
  transform: rotate(90deg);
}

.surface {
  overflow: hidden;
  border: 1rpx solid rgba(75, 93, 85, 0.1);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 26rpx rgba(35, 54, 46, 0.055);
}

.access-surface {
  padding: 0 26rpx;
}

.surface-label-row {
  justify-content: space-between;
  min-height: 74rpx;
  border-bottom: 1rpx solid #edf1ef;
}

.surface-label,
.quota-title {
  color: #303b37;
  font-size: 25rpx;
  font-weight: 800;
}

.surface-count,
.field-meta,
.report-count {
  color: #8a9390;
  font-size: 22rpx;
}

.provider-empty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  margin: 16rpx 0;
  padding: 18rpx;
  border: 1rpx dashed var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ffffff, var(--theme-soft, #eaf5ed));
}

.empty-add-mark,
.provider-logo,
.empty-shield {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.empty-add-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: var(--theme-primary, #2f7d50);
  box-shadow: 0 6rpx 18rpx rgba(35, 54, 46, 0.07);
}

.empty-add-mark view {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}

.empty-add-mark view::before,
.empty-add-mark view::after {
  position: absolute;
  top: 10rpx;
  left: 1rpx;
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.empty-add-mark view::after {
  transform: rotate(90deg);
}

.empty-title,
.compact-empty-title {
  color: #26312d;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.empty-copy,
.compact-empty-copy {
  margin-top: 5rpx;
  color: #7f8985;
  font-size: 22rpx;
  line-height: 1.4;
}

.empty-action {
  flex-shrink: 0;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 800;
}

.provider-row {
  padding: 22rpx 0 16rpx;
  border-bottom: 1rpx solid #edf1ef;
}

.provider-row:last-child {
  border-bottom: 0;
}

.provider-head {
  gap: 16rpx;
}

.provider-logo {
  width: 62rpx;
  height: 62rpx;
  border-radius: 13rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 22rpx;
  font-weight: 900;
}

.provider-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
}

.provider-name {
  min-width: 0;
  overflow: hidden;
  color: #24302c;
  font-size: 27rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.provider-health {
  flex-shrink: 0;
  color: #929a97;
  font-size: 22rpx;
  white-space: nowrap;
}

.provider-health.success {
  color: var(--theme-primary, #2f7d50);
}

.provider-health.failed {
  color: #b25140;
}

.provider-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #838c89;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-chevron {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.row-chevron::before {
  position: absolute;
  top: 8rpx;
  left: 7rpx;
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid #a0a7a4;
  border-right: 3rpx solid #a0a7a4;
  content: "";
  transform: rotate(45deg);
}

.provider-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf1ef;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 10rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 700;
}

.mini-action + .mini-action {
  margin-left: 12rpx;
}

.mini-action.danger {
  border-color: rgba(173, 77, 61, 0.14);
  background: #fff4f2;
  color: #ad4d3d;
}

.access-divider,
.form-divider {
  height: 1rpx;
  background: #e9eeeb;
}

.access-divider {
  margin-top: 2rpx;
}

.model-summary {
  min-height: 132rpx;
  gap: 16rpx;
  padding: 20rpx 0;
}

.model-mark {
  display: grid;
  grid-template-columns: repeat(2, 10rpx);
  grid-template-rows: repeat(2, 10rpx);
  align-content: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  gap: 6rpx;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
}

.model-mark view {
  border-radius: 3rpx;
  background: var(--theme-primary, #2f7d50);
}

.model-label {
  color: #89918e;
  font-size: 22rpx;
}

.model-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #25302d;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-copy {
  margin-top: 5rpx;
  overflow: hidden;
  color: #858e8b;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-state {
  flex-shrink: 0;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  background: #f2f4f3;
  color: #8a9290;
  font-size: 22rpx;
  white-space: nowrap;
}

.model-state.ready {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.settings-surface {
  padding: 26rpx;
}

.field-block {
  margin-top: 24rpx;
}

.first-field {
  margin-top: 0;
}

.field-label-line,
.quota-heading,
.output-limit-row {
  justify-content: space-between;
  gap: 18rpx;
}

.field-label,
.quota-label {
  color: #46514d;
  font-size: 25rpx;
  font-weight: 800;
}

.field-label {
  margin-bottom: 10rpx;
}

.field-label-line .field-label {
  margin-bottom: 10rpx;
}

.field-input,
.field-textarea,
.number-field {
  border: 1rpx solid #dde4e0;
  border-radius: 10rpx;
  background: #ffffff;
  color: #1c2723;
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
}

.field-textarea {
  width: 100%;
  padding: 17rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.prompt-textarea {
  height: 198rpx;
}

.quick-textarea {
  height: 142rpx;
}

.field-help {
  margin-top: 8rpx;
  color: #8a9390;
  font-size: 22rpx;
  line-height: 1.45;
}

.form-divider {
  margin: 28rpx 0 24rpx;
}

.quota-heading {
  align-items: flex-start;
}

.quota-copy {
  margin-top: 5rpx;
  color: #89918e;
  font-size: 22rpx;
}

.quota-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 17rpx;
}

.quota-field {
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid #e5eae7;
  border-radius: 12rpx;
  background: #f7f9f8;
}

.quota-label {
  margin-bottom: 10rpx;
}

.number-field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 66rpx;
  padding: 0 14rpx;
}

.number-field input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  color: #1f2a26;
  font-size: 27rpx;
  font-weight: 750;
}

.number-field text {
  flex-shrink: 0;
  color: #89918e;
  font-size: 22rpx;
  white-space: nowrap;
}

.output-limit-row {
  margin-top: 14rpx;
  padding: 17rpx 16rpx;
  border: 1rpx solid #e5eae7;
  border-radius: 12rpx;
  background: #f7f9f8;
}

.output-limit-copy {
  margin-top: 5rpx;
  color: #89918e;
  font-size: 22rpx;
  line-height: 1.4;
}

.output-number-field {
  width: 220rpx;
  flex-shrink: 0;
}

.save-settings {
  margin-top: 24rpx;
}

.runtime-surface,
.report-surface {
  padding: 0 22rpx;
}

.compact-empty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 2rpx;
}

.empty-chart {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  gap: 5rpx;
  padding: 13rpx 11rpx;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
}

.empty-chart view {
  width: 7rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: var(--theme-primary, #2f7d50);
}

.empty-chart view:nth-child(1) {
  height: 13rpx;
  opacity: 0.48;
}

.empty-chart view:nth-child(2) {
  height: 25rpx;
  opacity: 0.72;
}

.empty-chart view:nth-child(3) {
  height: 34rpx;
}

.usage-row {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  min-height: 76rpx;
  gap: 10rpx;
  border-top: 1rpx solid #edf1ef;
}

.usage-row:first-child {
  border-top: 0;
}

.usage-date {
  color: #3f4a46;
  font-size: 22rpx;
  font-weight: 750;
  white-space: nowrap;
}

.usage-results {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  font-size: 22rpx;
  white-space: nowrap;
}

.usage-success {
  color: var(--theme-primary, #2f7d50);
}

.usage-failed {
  color: #b25a48;
}

.usage-latency {
  color: #8b9390;
  font-size: 22rpx;
  text-align: right;
  white-space: nowrap;
}

.report-count {
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.empty-shield {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  font-size: 25rpx;
  font-weight: 900;
}

.report-row {
  padding: 20rpx 0;
  border-top: 1rpx solid #edf1ef;
}

.report-row:first-child {
  border-top: 0;
}

.report-head {
  justify-content: space-between;
  gap: 18rpx;
  color: #303b37;
  font-size: 25rpx;
  font-weight: 800;
}

.report-head text:last-child {
  flex-shrink: 0;
  color: #8b9390;
  font-size: 22rpx;
  font-weight: 500;
}

.report-excerpt,
.report-detail {
  margin-top: 9rpx;
  color: #59635f;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-word;
}

.report-detail {
  color: #818a87;
  font-size: 22rpx;
}

.report-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 10rpx;
}

.report-action {
  min-height: 46rpx;
  padding: 9rpx 10rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 22rpx;
  font-weight: 750;
}

.report-action.done {
  color: #8a9290;
}

.report-action.danger {
  color: #ad4d3d;
}

.ai-privacy-note {
  align-items: flex-start;
  gap: 13rpx;
  margin: 28rpx 6rpx 0;
  color: #747e7a;
  font-size: 23rpx;
  line-height: 1.55;
}

.privacy-lock {
  position: relative;
  width: 26rpx;
  height: 28rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.lock-shackle {
  position: absolute;
  top: 0;
  left: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid var(--theme-primary, #2f7d50);
  border-bottom: 0;
  border-radius: 9rpx 9rpx 0 0;
}

.lock-body {
  position: absolute;
  right: 1rpx;
  bottom: 0;
  left: 1rpx;
  height: 17rpx;
  border-radius: 5rpx;
  background: var(--theme-primary, #2f7d50);
}

@keyframes ai-signal {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.72;
    transform: scale(0.82);
  }
}

@media (prefers-reduced-motion: reduce) {
  .assistant-signal {
    animation: none;
  }
}

.ai-manage-error {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  font-size: 24rpx;
  font-weight: 900;
}

.error-title {
  margin-top: 24rpx;
  color: #26312d;
  font-size: 28rpx;
  font-weight: 850;
}

.error-copy {
  max-width: 560rpx;
  margin-top: 10rpx;
  color: #7f8985;
  font-size: 22rpx;
  line-height: 1.5;
}

.error-action {
  width: 260rpx;
  margin-top: 26rpx;
}
