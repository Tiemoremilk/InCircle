.login-page {
  padding-top: 22rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.login-shell {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-height: calc(100vh - 38rpx - env(safe-area-inset-bottom));
}

.inline-notice {
  position: fixed;
  top: 22rpx;
  right: 44rpx;
  left: 44rpx;
  z-index: 50;
  padding: 16rpx 22rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 14rpx 34rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
}

.inline-notice.error {
  border-color: rgba(201, 71, 71, 0.2);
  background: #fff6f5;
  color: #b13f3f;
}

.brand-panel {
  padding: 30rpx 30rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 72%, var(--theme-accent, #b8d966) 165%);
  color: #ffffff;
  box-shadow: 0 22rpx 50rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.brand-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  line-height: 1;
  font-weight: 800;
}

.hero-title {
  margin-top: 11rpx;
  font-size: 42rpx;
  line-height: 1.16;
  font-weight: 900;
}

.hero-copy {
  max-width: 610rpx;
  margin-top: 17rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.52;
}

.circle-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 14rpx;
  background: var(--theme-accent, #b8d966);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 31rpx;
  font-weight: 900;
}

.login-panel {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 28rpx;
  border-color: var(--theme-card-border, rgba(47, 125, 80, 0.09));
  box-shadow: 0 12rpx 34rpx rgba(28, 42, 36, 0.065);
}

.auth-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.auth-back,
.auth-head-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.auth-back {
  border: 1rpx solid rgba(28, 39, 35, 0.09);
  background: #f7f9f8;
}

.auth-head-icon {
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  background: var(--theme-soft, #eaf5ed);
}

.auth-back image,
.auth-head-icon image {
  width: 29rpx;
  height: 29rpx;
  filter: var(--theme-icon-filter, none);
}

.auth-head-copy {
  min-width: 0;
  flex: 1;
}

.panel-title {
  color: #17211e;
  font-size: 32rpx;
  line-height: 1.22;
  font-weight: 900;
}

.panel-copy {
  margin-top: 6rpx;
  color: #79827f;
  font-size: 23rpx;
  line-height: 1.42;
}

.step-rail {
  display: flex;
  align-items: center;
  margin: 24rpx 4rpx 0;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  color: #929a97;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 1rpx solid rgba(28, 39, 35, 0.11);
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.step-item.active {
  color: var(--theme-primary-dark, #1c5638);
}

.step-item.active .step-index {
  border-color: var(--theme-primary, #2f7d50);
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.step-line {
  height: 2rpx;
  min-width: 24rpx;
  margin: 0 12rpx;
  flex: 1;
  background: #e4e9e6;
}

.step-line.active {
  background: var(--theme-primary, #2f7d50);
}

.bind-alert {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 12rpx;
  background: var(--theme-soft, #eaf5ed);
}

.bind-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  font-weight: 900;
}

.bind-copy {
  margin-top: 7rpx;
  color: #65706c;
  font-size: 22rpx;
  line-height: 1.48;
}

.auth-form,
.profile-form {
  display: grid;
  gap: 20rpx;
  margin-top: 24rpx;
}

.auth-field {
  min-width: 0;
}

.auth-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.auth-label {
  color: #46524e;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.forgot-link {
  color: var(--theme-primary, #2f7d50);
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 800;
}

.input-shell {
  display: flex;
  align-items: center;
  width: 100%;
  height: 82rpx;
  margin-top: 10rpx;
  padding: 0 16rpx 0 18rpx;
  border: 1rpx solid #dde5e1;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.input-shell:focus-within {
  border-color: var(--theme-primary, #2f7d50);
  box-shadow: 0 0 0 3rpx var(--theme-soft, #eaf5ed);
}

.input-icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  margin-right: 13rpx;
  filter: var(--theme-icon-filter, none);
  opacity: 0.82;
}

.auth-input {
  min-width: 0;
  height: 80rpx;
  flex: 1;
  color: #17211e;
  font-size: 27rpx;
  line-height: 80rpx;
}

.password-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  margin-left: 6rpx;
}

.password-toggle image {
  width: 29rpx;
  height: 29rpx;
  filter: var(--theme-icon-filter, none);
  opacity: 0.72;
}

.profile-intro {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  border-radius: 14rpx;
  background: linear-gradient(100deg, var(--theme-soft, #eaf5ed) 0%, #ffffff 45%);
  box-sizing: border-box;
}

.avatar-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  min-height: 0;
  flex: 0 0 84rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 0;
}

.avatar-button::after {
  border: 0;
}

.avatar-button[disabled] {
  opacity: 0.56;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #edf0ee;
  box-shadow: 0 8rpx 18rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
  box-sizing: border-box;
}

.avatar-camera {
  position: absolute;
  right: -5rpx;
  bottom: -3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: var(--theme-primary, #2f7d50);
  box-sizing: border-box;
}

.avatar-camera image {
  width: 18rpx;
  height: 18rpx;
  filter: brightness(0) invert(1);
}

.profile-intro-copy {
  min-width: 0;
  flex: 1;
}

.profile-intro-title {
  overflow: hidden;
  color: #1f2b27;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-intro-note {
  margin-top: 7rpx;
  color: #74807b;
  font-size: 21rpx;
  line-height: 1.4;
}

.required-mark,
.optional-mark {
  color: var(--theme-primary, #2f7d50);
  font-size: 20rpx;
  font-weight: 700;
}

.optional-mark {
  color: #929a97;
}

.profile-optional-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.plain-input {
  width: 100%;
  height: 78rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dde5e1;
  border-radius: 12rpx;
  background: #ffffff;
  color: #17211e;
  font-size: 25rpx;
  line-height: 78rpx;
  box-sizing: border-box;
}

.auth-error,
.setup-error {
  margin-top: 20rpx;
  border-radius: 11rpx;
  box-sizing: border-box;
}

.auth-error {
  padding: 16rpx 17rpx;
  border: 1rpx solid rgba(201, 71, 71, 0.2);
  background: var(--theme-danger-soft, #fff1ef);
  box-shadow: 0 7rpx 18rpx rgba(166, 61, 61, 0.05);
}

.auth-error-heading,
.auth-error-title-group {
  display: flex;
  align-items: center;
}

.auth-error-heading {
  justify-content: space-between;
  gap: 16rpx;
  min-height: 36rpx;
}

.auth-error-title-group {
  min-width: 0;
  flex: 1;
  gap: 10rpx;
}

.auth-error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  border-radius: 50%;
  background: rgba(201, 71, 71, 0.1);
}

.auth-error-icon image {
  width: 19rpx;
  height: 19rpx;
  filter: invert(36%) sepia(25%) saturate(1719%) hue-rotate(314deg) brightness(91%) contrast(91%);
}

.auth-error-title {
  min-width: 0;
  color: #a63d3d;
  font-size: 22rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.auth-error-copy {
  margin-top: 4rpx;
  padding-left: 44rpx;
  color: #8f4b4b;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-word;
}

.auth-error-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 42rpx;
  padding: 0 14rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  border-radius: 10rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 19rpx;
  line-height: 1;
  font-weight: 900;
  box-sizing: border-box;
}

.auth-error-action-pressed {
  opacity: 0.7;
}

.setup-error {
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 23rpx;
  line-height: 1.5;
  font-weight: 700;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 15rpx 16rpx;
  border: 1rpx solid transparent;
  border-radius: 11rpx;
  color: #69746f;
  font-size: 22rpx;
  line-height: 1.55;
  transition: background 160ms ease, border-color 160ms ease;
}

.agreement-row.accepted {
  background: var(--theme-soft, #eaf5ed);
  color: #59655f;
}

.agreement-row.needs-attention {
  border-color: var(--theme-primary, #2f7d50);
  background: var(--theme-soft, #eaf5ed);
}

.agreement-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-top: 0;
  border: 2rpx solid #aab2af;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.accepted .agreement-check {
  border-color: var(--theme-primary, #2f7d50);
  background: var(--theme-primary, #2f7d50);
}

.agreement-check image {
  display: block;
  width: 20rpx;
  height: 20rpx;
  filter: brightness(0) invert(1);
  opacity: 0;
}

.accepted .agreement-check image {
  opacity: 1;
}

.agreement-copy {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
  min-height: 32rpx;
  flex: 1;
  line-height: 1.45;
}

.agreement-link {
  color: var(--theme-primary-dark, #1c5638);
  font-weight: 900;
}

.login-actions {
  margin-top: 20rpx;
}

.login-actions .primary-btn {
  width: 100%;
  height: 76rpx;
  border-radius: 11rpx;
  background: var(--theme-primary, #2f7d50);
  font-size: 27rpx;
  box-shadow: 0 10rpx 22rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.15));
}

.login-actions .primary-btn[disabled] {
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638) !important;
  -webkit-text-fill-color: currentColor;
  opacity: 0.62;
  box-shadow: none;
}

.auth-secondary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 70rpx;
  margin-top: auto;
  padding: 0 20rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 11rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
  box-sizing: border-box;
}

.auth-secondary-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.auth-secondary-main image,
.auth-secondary-arrow {
  width: 25rpx;
  height: 25rpx;
  filter: var(--theme-icon-filter, none);
}

.auth-secondary-arrow {
  opacity: 0.72;
}

.return-login {
  margin-top: auto;
  padding-top: 26rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 800;
  text-align: center;
}

@media (max-width: 340px) {
  .profile-optional-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .step-item {
    font-size: 20rpx;
  }

  .login-panel {
    padding: 24rpx;
  }
}
