<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>
<view class="page login-page {{themeClass}}" wx:if="{{!loading}}">
  <view class="inline-notice {{feedbackType}}" wx:if="{{feedbackText}}">{{feedbackText}}</view>

  <view class="login-shell">
    <view class="brand-panel motion-hero">
      <view class="brand-main">
        <view>
          <view class="eyebrow">InCircle</view>
          <view class="hero-title">先认人，再进圈。</view>
        </view>
        <view class="circle-mark motion-theme-mark">圈</view>
      </view>
      <view class="hero-copy">{{heroCopy}}</view>
    </view>

    <view class="login-panel card motion-section">
      <view class="auth-head">
        <view
          class="auth-back"
          wx:if="{{(mode === 'register' || mode === 'forgot') || ((mode === 'bind') && registerStep === 2)}}"
          bindtap="backAuthFlow"
        >
          <image src="/images/ui-icons/arrow-left.svg" mode="aspectFit"></image>
        </view>
        <view class="auth-head-icon">
          <image src="{{modeIcon}}" mode="aspectFit"></image>
        </view>
        <view class="auth-head-copy">
          <view class="panel-title">{{modeTitle}}</view>
          <view class="panel-copy">{{modeCopy}}</view>
        </view>
      </view>

      <view class="step-rail" wx:if="{{mode === 'register' || mode === 'bind'}}">
        <view class="step-item {{registerStep >= 1 ? 'active' : ''}}">
          <view class="step-index">1</view>
          <text>账号安全</text>
        </view>
        <view class="step-line {{registerStep === 2 ? 'active' : ''}}"></view>
        <view class="step-item {{registerStep === 2 ? 'active' : ''}}">
          <view class="step-index">2</view>
          <text>圈内资料</text>
        </view>
      </view>

      <view class="bind-alert" wx:if="{{mode === 'bind' && registerStep === 1}}">
        <view class="bind-title">原有数据会完整保留</view>
        <view class="bind-copy">这里只补充账号密码，不会创建新用户或改变你的圈子身份。</view>
      </view>

      <view
        class="auth-form"
        wx:if="{{mode === 'login' || mode === 'forgot' || ((mode === 'register' || mode === 'bind') && registerStep === 1)}}"
      >
        <view class="auth-field">
          <view class="auth-label">账号</view>
          <view class="input-shell">
            <image class="input-icon" src="/images/ui-icons/account.svg" mode="aspectFit"></image>
            <input
              class="auth-input"
              adjust-position="{{true}}"
              cursor-spacing="24"
              value="{{account}}"
              placeholder="手机号、邮箱或英文数字账号"
              bindinput="onAccountInput"
            />
          </view>
        </view>

        <view class="auth-field">
          <view class="auth-label-row">
            <view class="auth-label">{{mode === 'login' ? '密码' : mode === 'forgot' ? '新密码' : '设置密码'}}</view>
            <view class="forgot-link" wx:if="{{mode === 'login'}}" data-mode="forgot" bindtap="switchMode">忘记密码</view>
          </view>
          <view class="input-shell">
            <image class="input-icon" src="/images/ui-icons/lock-keyhole.svg" mode="aspectFit"></image>
            <input
              class="auth-input"
              password="{{!passwordVisible}}"
              adjust-position="{{true}}"
              cursor-spacing="24"
              value="{{password}}"
              placeholder="{{mode === 'login' ? '请输入密码' : '8-64 位，包含字母和数字'}}"
              bindinput="onPasswordInput"
            />
            <view class="password-toggle" bindtap="togglePasswordVisibility">
              <image src="{{passwordVisible ? '/images/ui-icons/eye-off.svg' : '/images/ui-icons/eye.svg'}}" mode="aspectFit"></image>
            </view>
          </view>
        </view>

        <view class="auth-field" wx:if="{{mode !== 'login'}}">
          <view class="auth-label">确认密码</view>
          <view class="input-shell">
            <image class="input-icon" src="/images/ui-icons/shield-check.svg" mode="aspectFit"></image>
            <input
              class="auth-input"
              password="{{!confirmPasswordVisible}}"
              adjust-position="{{true}}"
              cursor-spacing="24"
              value="{{confirmPassword}}"
              placeholder="再次输入新密码"
              bindinput="onConfirmPasswordInput"
            />
            <view class="password-toggle" bindtap="toggleConfirmPasswordVisibility">
              <image src="{{confirmPasswordVisible ? '/images/ui-icons/eye-off.svg' : '/images/ui-icons/eye.svg'}}" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>

      <view
        class="agreement-row {{agreementAccepted ? 'accepted' : ''}} {{agreementAttention ? 'needs-attention' : ''}}"
        bindtap="toggleAgreement"
      >
        <view class="agreement-check"><image src="/images/ui-icons/check.svg" mode="aspectFit"></image></view>
        <view class="agreement-copy">
          <text>我已阅读并同意</text>
          <text class="agreement-link" data-type="terms" catchtap="openLegal">《用户服务协议》</text>
          <text>和</text>
          <text class="agreement-link" data-type="privacy" catchtap="openLegal">《隐私政策》</text>
        </view>
      </view>

      <view class="profile-form" wx:if="{{(mode === 'register' || mode === 'bind') && registerStep === 2}}">
        <view class="profile-intro">
          <button
            class="avatar-button"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
            disabled="{{avatarUploading || submitting || !agreementAccepted}}"
          >
            <image class="avatar" src="{{avatarUrlDisplay || avatarUrl}}"></image>
            <view class="avatar-camera"><image src="/images/ui-icons/camera.svg" mode="aspectFit"></image></view>
          </button>
          <view class="profile-intro-copy">
            <view class="profile-intro-title">{{displayName}}</view>
            <view class="profile-intro-note">{{avatarUploading ? '头像上传中...' : '头像和昵称仅按圈内权限展示'}}</view>
          </view>
        </view>

        <view class="auth-field">
          <view class="auth-label-row"><view class="auth-label">圈内昵称</view><text class="required-mark">必填</text></view>
          <view class="input-shell">
            <image class="input-icon" src="/images/ui-icons/profile.svg" mode="aspectFit"></image>
            <input class="auth-input" type="nickname" adjust-position="{{true}}" cursor-spacing="24" value="{{nickName}}" placeholder="选择微信昵称，或手动填写" bindinput="onNickInput" bindblur="onNickInput" />
          </view>
        </view>

        <view class="auth-field">
          <view class="auth-label-row"><view class="auth-label">手机号</view><text class="required-mark">必填</text></view>
          <view class="input-shell">
            <image class="input-icon" src="/images/ui-icons/phone.svg" mode="aspectFit"></image>
            <input class="auth-input" type="number" maxlength="11" adjust-position="{{true}}" cursor-spacing="24" value="{{phone}}" placeholder="用于圈内结款和必要联系" bindinput="onPhoneInput" />
          </view>
        </view>

        <view class="profile-optional-grid">
          <view class="auth-field">
            <view class="auth-label">圈内称呼 <text class="optional-mark">选填</text></view>
            <input class="plain-input" adjust-position="{{true}}" cursor-spacing="24" value="{{title}}" placeholder="例如：羽毛球搭子" bindinput="onTitleInput" />
          </view>
          <view class="auth-field">
            <view class="auth-label">个人备注 <text class="optional-mark">选填</text></view>
            <input class="plain-input" adjust-position="{{true}}" cursor-spacing="24" value="{{profileNote}}" placeholder="可约时间、忌口等" bindinput="onNoteInput" />
          </view>
        </view>
      </view>

      <view class="auth-error" wx:if="{{hasBackendError}}">
        <view class="auth-error-title">操作未完成</view>
        <view class="auth-error-copy">{{backendError}}</view>
        <view class="auth-error-action" bindtap="retrySession">重新加载</view>
      </view>
      <view class="setup-error" wx:if="{{setupError}}">{{setupError}}</view>

      <view class="login-actions">
        <button
          wx:if="{{(mode === 'register' || mode === 'bind') && registerStep === 1}}"
          class="primary-btn"
          bindtap="nextRegistrationStep"
          disabled="{{loginDisabled}}"
        >下一步</button>
        <button
          wx:else
          class="primary-btn"
          bindtap="submitAuth"
          disabled="{{loginDisabled}}"
        >{{primaryButtonText}}</button>
      </view>

      <view class="auth-secondary" wx:if="{{mode === 'login'}}" data-mode="register" bindtap="switchMode">
        <view class="auth-secondary-main">
          <image src="/images/ui-icons/user-plus.svg" mode="aspectFit"></image>
          <text>创建账号</text>
        </view>
        <image class="auth-secondary-arrow" src="/images/ui-icons/arrow-right.svg" mode="aspectFit"></image>
      </view>
      <view class="return-login" wx:if="{{mode === 'register' || mode === 'forgot'}}" data-mode="login" bindtap="switchMode">已有账号，返回登录</view>
    </view>
  </view>
</view>

<view class="page loading-page {{themeClass}}" wx:else>
  <view class="loading-panel">
    <view class="loading-illustration">
      <view class="loading-card-line first"></view>
      <view class="loading-card-line second"></view>
      <view class="loading-card-line third"></view>
      <view class="loading-card-mark"></view>
    </view>
    <view class="loading-text">正在检查登录状态...</view>
    <view class="loading-dots"><view></view><view></view><view></view></view>
  </view>
</view>
<theme-dialog id="incircle-theme-dialog" />
