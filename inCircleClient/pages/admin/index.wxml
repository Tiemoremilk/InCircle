<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>
<view class="page admin-page {{themeClass}}" wx:if="{{!loading}}">
  <view wx:if="{{isSuperAdmin}}">
    <view class="admin-hero card motion-hero">
      <view class="hero-row">
        <view>
          <view class="eyebrow">运营与安全</view>
          <view class="hero-title">管理中心</view>
        </view>
        <view class="circle-mark motion-theme-mark">
          <image class="hero-icon" src="/images/ui-icons/admin.svg"></image>
        </view>
      </view>
      <view class="hero-copy">集中处理圈子状态、用户账号与必要操作流水。</view>
      <view class="metrics-grid">
        <view class="metric {{metricIndex < 6 ? 'motion-list-item' : ''}}" wx:for="{{metrics}}" wx:key="label" wx:for-index="metricIndex" style="animation-delay: {{metricIndex * 35}}ms;">
          <view class="metric-value">{{item.value}}</view>
          <view class="metric-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="section management-hub">
      <view class="section-title">管理入口</view>
      <view class="hub-entry motion-list-item" bindtap="openAdminCircles">
        <view class="hub-icon"><image src="/images/ui-icons/layers.svg" mode="aspectFit"></image></view>
        <view class="hub-copy"><view class="hub-title">管理所有圈子</view><view class="hub-subtitle">{{circleSummary.total}} 个圈子 · {{circleSummary.frozen}} 个冻结</view></view>
        <view class="hub-arrow">›</view>
      </view>
      <view class="hub-entry motion-list-item" style="animation-delay: 35ms;" bindtap="openAdminUsers">
        <view class="hub-icon"><image src="/images/ui-icons/profile.svg" mode="aspectFit"></image></view>
        <view class="hub-copy"><view class="hub-title">用户管理</view><view class="hub-subtitle">{{userSummary.total}} 个用户 · {{userSummary.blocked}} 个封禁</view></view>
        <view class="hub-arrow">›</view>
      </view>
    </view>

    <view class="section platform-capability">
      <view class="section-title">平台能力</view>
      <view class="capability-group card motion-section">
        <view class="capability-item">
          <view class="capability-icon">
            <image src="/images/ui-icons/sparkles.svg" mode="aspectFit"></image>
          </view>
          <view class="capability-copy">
            <view class="capability-title-row">
              <view class="capability-title">圈内 AI</view>
              <view class="capability-state {{platformSettings.circleAiEnabled ? 'is-on' : 'is-off'}}">
                {{platformSettings.circleAiEnabled ? "已开放" : "已关闭"}}
              </view>
            </view>
            <view class="capability-subtitle">
              {{platformSettings.circleAiEnabled ? "各圈可按需接入第三方模型" : "所有圈子的入口与设置均已隐藏"}}
            </view>
          </view>
          <switch
            class="capability-switch"
            checked="{{platformSettings.circleAiEnabled}}"
            disabled="{{platformAiBusy}}"
            color="{{themePrimary}}"
            bindchange="togglePlatformAi"
          />
        </view>

        <view class="capability-divider"></view>

        <view class="capability-item capability-dependent {{!platformSettings.circleAiEnabled || !platformSettings.webSearchConfigured ? 'is-disabled' : ''}}">
          <view class="capability-icon">
            <image src="/images/ui-icons/search.svg" mode="aspectFit"></image>
          </view>
          <view class="capability-copy">
            <view class="capability-title-row">
              <view class="capability-title">联网搜索</view>
              <view class="capability-state {{!platformSettings.webSearchConfigured ? 'is-unconfigured' : (platformSettings.webSearchEnabled ? 'is-on' : 'is-off')}}">
                {{!platformSettings.webSearchConfigured ? "未配置" : (platformSettings.webSearchEnabled ? "已开放" : "已关闭")}}
              </view>
            </view>
            <view class="capability-subtitle">
              {{!platformSettings.circleAiEnabled ? "需先开放圈内 AI" : (!platformSettings.webSearchConfigured ? "SearXNG 搜索服务尚未配置" : (platformSettings.webSearchEnabled ? "用户可在对话中按需搜索" : "对话页不会显示联网选项"))}}
            </view>
          </view>
          <switch
            class="capability-switch"
            checked="{{platformSettings.webSearchEnabled}}"
            disabled="{{platformSearchBusy || !platformSettings.circleAiEnabled || !platformSettings.webSearchConfigured}}"
            color="{{themePrimary}}"
            bindchange="togglePlatformSearch"
          />
        </view>

        <view class="capability-note">
          <view class="capability-note-mark"></view>
          <text>{{platformAiBusy || platformSearchBusy ? "正在同步平台状态" : (!platformSettings.circleAiEnabled ? "重新开放圈内 AI 后，可继续使用已有配置" : (!platformSettings.webSearchConfigured ? "请先完成 SearXNG 服务配置" : (platformSettings.webSearchEnabled ? "联网搜索已开放，用户可在对话中按需使用" : "普通 AI 对话不受影响，对话页不显示联网选项")))}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view class="section-title with-icon">
        <image class="section-icon" src="/images/ui-icons/history.svg"></image>
          <text>管理日志</text>
        </view>
        <view class="section-action">{{logTotal}} 条</view>
      </view>
      <view class="log-card card" wx:if="{{logsPreview.length}}">
        <view class="log-row {{logIndex < 6 ? 'motion-list-item' : ''}}" wx:for="{{logsPreview}}" wx:key="id" wx:for-index="logIndex" style="animation-delay: {{logIndex * 35}}ms;">
          <view class="log-main">
            <view class="log-title">{{item.actionText}}</view>
            <view class="log-summary">{{item.summaryText}}</view>
          </view>
          <view class="log-side">
            <view class="log-actor">{{item.actorName}}</view>
            <view class="log-time">{{item.createdAtText}}</view>
          </view>
        </view>
        <view class="view-more-row" wx:if="{{hasMoreLogs}}" bindtap="openAdminLogs">
          <text>查看更多</text>
          <text class="view-more-meta">共 {{logTotal}} 条</text>
        </view>
      </view>
      <empty-state
        wx:else
        kind="log"
        icon="/images/ui-icons/history.svg"
        title="还没有管理日志"
        description="圈子状态或成员关系发生管理操作后，会留下必要流水。"
        compact="{{true}}"
      />
    </view>

  </view>

  <view class="denied-card card" wx:else>
    <view class="denied-title">页面不可用</view>
  </view>
</view>

<view class="page loading-page {{themeClass}}" wx:else>
  <view class="loading-panel">
    <view class="loading-illustration">
      <view class="loading-card-line first"></view>
      <view class="loading-card-line second"></view>
      <view class="loading-card-line third"></view>
      <view class="loading-card-mark"></view>
    </view>
    <view class="loading-text">正在读取管理中心...</view>
    <view class="loading-dots"><view></view><view></view><view></view></view>
  </view>
</view>
<theme-dialog id="incircle-theme-dialog" />
