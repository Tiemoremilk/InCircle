.admin-page {
  padding-top: 24rpx;
}

.admin-hero {
  padding: 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 70%, var(--theme-accent, #b8d966) 160%);
  box-shadow: 0 22rpx 50rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.hero-row,
.circle-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 900;
}

.hero-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 27rpx;
  line-height: 1.5;
}

.circle-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: var(--theme-accent, #b8d966);
  color: var(--theme-primary-dark, #1c5638);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.hero-icon {
  width: 48rpx;
  height: 48rpx;
}

.section-title.with-icon {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.admin-page .section-head {
  margin-bottom: 12rpx;
}

.admin-page .section-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.admin-page .section-action {
  font-size: 22rpx;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 30rpx;
}

.metric {
  min-width: 0;
  padding: 20rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.12);
}

.metric-value {
  color: #ffffff;
  font-size: 34rpx;
  text-align: center;
  line-height: 1;
  font-weight: 900;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: center;
}

.admin-hero .metric-value,
.theme-ocean .admin-hero .metric-value,
.theme-berry .admin-hero .metric-value,
.theme-graphite .admin-hero .metric-value,
.theme-coral .admin-hero .metric-value,
.theme-peacock .admin-hero .metric-value,
.theme-iris .admin-hero .metric-value,
.theme-cyan .admin-hero .metric-value {
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.16);
}

.admin-hero .metric-label,
.theme-ocean .admin-hero .metric-label,
.theme-berry .admin-hero .metric-label,
.theme-graphite .admin-hero .metric-label,
.theme-coral .admin-hero .metric-label,
.theme-peacock .admin-hero .metric-label,
.theme-iris .admin-hero .metric-label,
.theme-cyan .admin-hero .metric-label {
  color: rgba(255, 255, 255, 0.84);
}

.member-card,
.denied-card {
  padding: 28rpx;
  margin-bottom: 18rpx;
}

.management-hub > .section-title {
  margin-bottom: 12rpx;
}

.hub-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 92rpx;
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  border-radius: 14rpx;
  background: var(--theme-card-bg, #ffffff);
  box-shadow: 0 8rpx 22rpx rgba(30, 48, 40, 0.05);
  box-sizing: border-box;
}

.hub-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
}

.hub-icon image { width: 34rpx; height: 34rpx; }
.hub-copy { min-width: 0; flex: 1; }
.hub-title { color: #202b27; font-size: 27rpx; line-height: 1.3; font-weight: 800; }
.hub-subtitle { margin-top: 6rpx; color: #7b8581; font-size: 22rpx; }
.hub-arrow { color: var(--theme-primary, #2f7d50); font-size: 38rpx; line-height: 1; }

.circle-list {
  overflow: hidden;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(35, 54, 46, 0.05);
}

.circle-row {
  padding: 21rpx 22rpx 18rpx;
}

.circle-row + .circle-row {
  border-top: 1rpx solid #e9eeeb;
}

.circle-top {
  align-items: center;
  gap: 16rpx;
}

.circle-main {
  flex: 1;
  min-width: 0;
}

.circle-title,
.denied-title {
  color: #17211e;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
}

.circle-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a8581;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circle-status {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 7rpx;
  background: transparent;
  color: var(--theme-primary, #2f7d50);
  font-size: 21rpx;
  line-height: 1;
  font-weight: 700;
}

.circle-status .status-dot {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: currentColor;
}

.circle-status.pill-red {
  color: #b34a34;
}

.admin-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 17rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1ef;
}

.admin-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 60rpx;
  padding: 0 10rpx;
  border: 1rpx solid #dfe6e2;
  border-radius: 8rpx;
  background: #f8faf9;
  color: #34403b;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  box-sizing: border-box;
}

.admin-action text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-action {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
}

.delete-action {
  border: 1rpx solid rgba(179, 74, 52, 0.18);
  background: #fff7f4;
  color: #b34a34;
}

.admin-action:active {
  opacity: 0.82;
  transform: scale(0.985);
}

.admin-action.disabled {
  opacity: 0.62;
  transform: none;
  pointer-events: none;
}

.section-action.disabled {
  opacity: 0.62;
}

.log-card,
.empty-log {
  margin-bottom: 18rpx;
}

.log-card {
  overflow: hidden;
  padding: 0 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(35, 54, 46, 0.05);
}

.empty-log {
  padding: 24rpx;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.log-row + .log-row {
  border-top: 1rpx solid #edf0ee;
}

.view-more-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 64rpx;
  border-top: 1rpx solid #edf0ee;
  color: var(--theme-primary, #2f7d50);
  font-size: 23rpx;
  font-weight: 800;
}

.view-more-meta {
  color: #8a9490;
  font-size: 21rpx;
  font-weight: 700;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-title {
  color: #17211e;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 800;
}

.log-summary {
  margin-top: 5rpx;
  overflow: hidden;
  color: #77827d;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-side {
  width: 216rpx;
  flex-shrink: 0;
  text-align: right;
}

.log-actor {
  color: var(--theme-primary, #2f7d50);
  overflow: hidden;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-time {
  margin-top: 5rpx;
  color: #8a9490;
  font-size: 20rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.admin-empty {
  padding: 28rpx;
  color: #7a8581;
  font-size: 23rpx;
  text-align: center;
}

.member-row {
  display: grid;
  grid-template-columns: 1fr 1.25fr 0.7fr;
  gap: 12rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf0ee;
  color: #4d5653;
  font-size: 24rpx;
  font-weight: 800;
}

.member-row.head {
  border-top: none;
  padding-top: 0;
  color: var(--theme-primary-dark, #1c5638);
  font-size: 23rpx;
  font-weight: 900;
}

.role-text {
  color: var(--theme-primary, #2f7d50);
}

.denied-card {
  margin-top: 120rpx;
  text-align: center;
}
