.detail-page {
  padding-top: 24rpx;
}

.detail-hero {
  padding: 34rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 62%, var(--theme-accent, #b8d966) 150%);
  color: #ffffff;
  box-shadow: 0 22rpx 54rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.hero-topline,
.section-head,
.recap-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.activity-type {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 900;
}

.detail-title {
  margin-top: 14rpx;
  font-size: 46rpx;
  line-height: 1.16;
  font-weight: 900;
}

.detail-meta {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.45;
}

.location-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.location-content {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.location-title {
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-copy {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.4;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.location-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 126rpx;
  height: 44rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.17);
  color: #ffffff;
  text-align: center;
  line-height: 42rpx;
  font-size: 22rpx;
  font-weight: 800;
  box-sizing: border-box;
  white-space: nowrap;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  text-shadow: 0 1rpx 2rpx rgba(18, 30, 25, 0.16);
}

.location-action > text {
  color: #ffffff;
}

.detail-hero .location-action.hero-pill {
  border-color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.17);
  color: #ffffff;
}

.hero-note {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #fff2cf;
  font-size: 24rpx;
  line-height: 1.45;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 18rpx;
  background: var(--theme-soft, #eaf5ed);
  box-shadow: 0 10rpx 24rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.08));
  box-sizing: border-box;
}

.quick-actions.has-delete {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.quick-action-slot {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.quick-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  min-height: 64rpx;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  border-radius: 12rpx;
  background: #ffffff;
  color: var(--theme-primary-dark, #1c5638);
  text-align: center;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 900;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(24, 33, 31, 0.05);
  box-sizing: border-box;
}

.quick-action-slot > button.quick-action {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.quick-action > text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action::after {
  border: 0;
}

.share-action {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.3));
  color: var(--theme-primary-dark, #1c5638);
  -webkit-text-fill-color: var(--theme-primary-dark, #1c5638);
}

.share-action > text {
  color: var(--theme-primary-dark, #1c5638);
  -webkit-text-fill-color: var(--theme-primary-dark, #1c5638);
}

.bill-action {
  border-color: transparent;
  background: linear-gradient(135deg, var(--theme-primary, #2f7d50), var(--theme-primary-dark, #1c5638));
  color: #ffffff;
  -webkit-text-fill-color: #ffffff;
  box-shadow: 0 8rpx 18rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.16));
}

.bill-action > text {
  color: #ffffff;
  -webkit-text-fill-color: #ffffff;
}

.quick-action-pressed {
  opacity: 0.76;
  transform: scale(0.98);
}

.quick-action.disabled,
.status-btn.disabled,
.empty-card.disabled {
  opacity: 0.62;
}

.quick-action.danger {
  height: 64rpx;
  min-height: 64rpx;
  margin-top: 0;
  border: 1rpx solid rgba(179, 74, 52, 0.18);
  border-radius: 12rpx;
  background: var(--theme-danger-soft, #fff3ef);
  color: #b34a34;
  box-shadow: 0 4rpx 12rpx rgba(179, 74, 52, 0.05);
}

.quick-action.danger > text {
  color: #b34a34;
}

.recap-cta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 94rpx;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  border-left: 6rpx solid var(--theme-primary, #2f7d50);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.08));
  box-sizing: border-box;
}

.recap-cta-pressed {
  opacity: 0.78;
  transform: scale(0.99);
}

.recap-cta.disabled {
  opacity: 0.62;
}

.recap-cta-icon,
.recap-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  background: var(--theme-soft, #eaf5ed);
}

.recap-cta-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 15rpx;
}

.recap-cta-icon image {
  width: 31rpx;
  height: 31rpx;
  filter: var(--theme-icon-filter, none);
}

.recap-cta-copy,
.recap-empty-copy {
  min-width: 0;
  flex: 1;
}

.recap-cta-title,
.recap-empty-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 900;
}

.recap-cta-hint,
.recap-empty-description {
  margin-top: 5rpx;
  color: #71807a;
  font-size: 19rpx;
  line-height: 1.35;
}

.recap-cta-arrow {
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 25rpx;
  opacity: 0.64;
  filter: var(--theme-icon-filter, none);
}

.state-card,
.recap-card {
  padding: 28rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  background: var(--theme-card-bg, #ffffff);
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #edf0ee;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--theme-primary, #2f7d50), var(--theme-accent, #b8d966));
}

.progress-copy {
  margin-top: 12rpx;
  color: #4d5653;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.status-btn {
  height: 58rpx;
  border-radius: 12rpx;
  background: #eef2ef;
  color: #26312e;
  text-align: center;
  line-height: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status-btn.active {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.group-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.group-card {
  min-height: 150rpx;
  padding: 22rpx;
}

.group-label {
  color: #17211e;
  font-size: 27rpx;
  font-weight: 900;
}

.group-members {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.empty-text {
  color: #79827f;
  font-size: 23rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-card {
  position: relative;
  overflow: hidden;
  height: 150rpx;
  border-radius: 16rpx;
  padding: 18rpx;
  color: #ffffff;
  display: flex;
  align-items: flex-end;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 26rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.12));
}

.photo-card.green {
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638), var(--theme-primary, #2f7d50));
}

.photo-card.amber {
  background: linear-gradient(135deg, #a05b00, var(--theme-accent, #b8d966));
}

.photo-card.with-image {
  background: var(--theme-primary-dark, #1c5638);
  padding: 0;
}

.photo-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.photo-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(13, 22, 20, 0) 0%, rgba(13, 22, 20, 0.68) 100%);
}

.photo-title {
  position: relative;
  z-index: 1;
  padding: 0 14rpx 14rpx;
  line-height: 1.25;
}

.empty-card {
  padding: 28rpx;
  color: #79827f;
  font-size: 24rpx;
  line-height: 1.5;
}

.recap-row {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--theme-card-border, #edf0ee);
  color: #4d5653;
  font-size: 25rpx;
  font-weight: 800;
}

.recap-row:first-child {
  border-top: none;
}

.recap-note {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 800;
}

.recap-empty {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx dashed var(--theme-card-active-border, rgba(47, 125, 80, 0.25));
  border-radius: 16rpx;
  background: var(--theme-soft, #eaf5ed);
  box-sizing: border-box;
}

.recap-empty-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
}

.recap-empty-icon image {
  width: 28rpx;
  height: 28rpx;
  filter: var(--theme-icon-filter, none);
}

.recap-empty-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  height: 34rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  background: var(--theme-card-bg, #ffffff);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 17rpx;
  line-height: 1;
  font-weight: 800;
}
