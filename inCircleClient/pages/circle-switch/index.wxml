<page-meta page-style="{{themeStyle}} {{incircleKeyboardPageStyle}}"></page-meta>
<view class="page circle-page {{themeClass}}" wx:if="{{!loading}}">
  <view class="circle-overview motion-hero">
    <view class="overview-profile">
      <image class="overview-avatar" src="{{user.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
      <view class="overview-copy">
        <view class="overview-title">{{user.nickName}} 的圈子</view>
        <view class="overview-subtitle">选择一个熟人圈继续</view>
      </view>
      <view class="overview-account" bindtap="openAccountSettings">
        <image src="/images/ui-icons/account.svg" mode="aspectFit"></image>
        <text>账号设置</text>
      </view>
      <view class="overview-count motion-theme-mark">{{joinedCount}}</view>
    </view>
    <view class="overview-stats">
      <view class="overview-stat"><text class="overview-value">{{joinedCount}}</text><text class="overview-label">已加入</text></view>
      <view class="overview-stat"><text class="overview-value">{{managedCount}}</text><text class="overview-label">我管理</text></view>
      <view class="overview-stat"><text class="overview-value">{{currentMemberCount}}</text><text class="overview-label">当前成员</text></view>
    </view>
  </view>

  <view class="circle-launchpad">
    <view class="page-actions">
      <view class="circle-action join-action motion-state {{switchingCircle || creatingCircle ? 'disabled' : ''}}" bindtap="openJoin">
        <view class="circle-action-icon"><image src="/images/ui-icons/qr-code.svg" mode="aspectFit"></image></view>
        <view class="circle-action-copy"><text class="circle-action-title">加入圈子</text><text class="circle-action-hint">邀请码或扫码</text></view>
      </view>
      <view class="circle-action create-action motion-state {{!isSuperAdmin && !canCreateCircle ? 'at-limit' : ''}} {{switchingCircle || creatingCircle ? 'disabled' : ''}}" bindtap="createCircle">
        <view class="circle-action-icon"><image src="/images/ui-icons/layers.svg" mode="aspectFit"></image></view>
        <view class="circle-action-copy">
          <text class="circle-action-title">{{creatingCircle ? '创建中...' : !isSuperAdmin && !canCreateCircle ? '已达创建上限' : '创建圈子'}}</text>
          <text class="circle-action-hint" wx:if="{{!isSuperAdmin}}">已创建 {{ownedCircleCount}} / {{circleCreateLimit}}</text>
          <text class="circle-action-hint" wx:else>建立新的熟人圈</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section circle-section">
    <view class="section-head">
      <view class="section-title">常用圈子</view>
      <view class="section-action {{switchingCircle || creatingCircle ? 'disabled' : ''}}" bindtap="loadCircles">{{switchingCircle ? '正在进入' : creatingCircle ? '创建中' : '刷新'}}</view>
    </view>

    <view class="switching-banner" wx:if="{{switchingCircle}}"><view class="switching-spinner"></view><view class="switching-text">正在进入「{{switchingCircleName}}」...</view></view>

    <view class="circle-list-shell" wx:if="{{hasCircles}}">
      <view class="recent-circle-row motion-state {{circleIndex < 6 ? 'motion-list-item' : ''}} {{item.currentClass}} {{item.disabledClass}}" wx:for="{{circles}}" wx:key="id" wx:for-index="circleIndex" style="animation-delay: {{circleIndex * 35}}ms;">
        <view class="circle-top">
          <view class="circle-main"><view class="circle-title">{{item.name}}</view><view class="circle-copy">{{item.slogan || '这个圈子还没有填写介绍'}}</view></view>
          <view class="pill {{item.statusClass}}">{{item.displayStatusText}}</view>
        </view>
        <view class="circle-meta-row"><text>{{item.role}}</text><text>·</text><text>{{item.memberText}}</text><text>·</text><text>{{item.lastEnteredText}}</text></view>
        <view class="circle-actions">
          <view class="primary-btn small-btn {{switchingCircle || creatingCircle ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="switchCircle" wx:if="{{item.canEnter}}">{{switchingCircleId === item.id ? '正在进入...' : item.isCurrent || item.currentClass === 'active' ? '进入圈子' : '切换进入'}}</view>
          <view class="circle-settings-btn {{!item.canEnter ? 'only-action' : ''}} {{switchingCircle || creatingCircle ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="openSettings"><image src="/images/ui-icons/settings.png" mode="aspectFit"></image><text>设置</text></view>
        </view>
      </view>
      <view class="view-all-circles" wx:if="{{hasMoreCircles}}" bindtap="openAllCircles"><text>查看全部 {{circleTotal}} 个圈子</text><text class="view-all-arrow">›</text></view>
    </view>

    <empty-state wx:else kind="circle" icon="/images/ui-icons/layers.svg" eyebrow="先找到你的熟人圈" title="还没有加入圈子" description="输入邀请码，或从微信群里的分享卡片进入；也可以自己创建一个。" compact="{{true}}" />

    <view class="circle-home-entry motion-state {{switchingCircle || creatingCircle ? 'disabled' : ''}}" bindtap="openHome" wx:if="{{hasCurrentCircle}}">
      <view class="circle-home-icon"><image src="/images/ui-icons/home.png" mode="aspectFit"></image></view>
      <view class="circle-home-copy"><view class="circle-home-title">进入当前圈子首页</view><view class="circle-home-name">{{currentCircle.name || '当前圈子'}}</view></view>
      <image class="circle-home-arrow" src="/images/ui-icons/arrow-right.svg" mode="aspectFit"></image>
    </view>
  </view>
</view>

<view class="page loading-page {{themeClass}}" wx:else>
  <view class="loading-panel"><view class="loading-illustration"><view class="loading-card-line first"></view><view class="loading-card-line second"></view><view class="loading-card-line third"></view><view class="loading-card-mark"></view></view><view class="loading-text">正在整理我的圈子...</view><view class="loading-dots"><view></view><view></view><view></view></view></view>
</view>
<theme-dialog id="incircle-theme-dialog" />
