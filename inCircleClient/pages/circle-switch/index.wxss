.circle-page {
  padding-top: 24rpx;
}

.circle-overview {
  padding: 26rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  border-radius: 16rpx;
  background: linear-gradient(145deg, var(--theme-primary-dark, #1c5638), var(--theme-primary, #2f7d50));
  box-shadow: 0 14rpx 34rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.16));
  color: #ffffff;
}

.overview-profile {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.overview-avatar {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.overview-copy {
  min-width: 0;
  flex: 1;
}

.overview-title {
  overflow: hidden;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-account {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 12rpx;
  flex: 0 0 auto;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.94);
  font-size: 19rpx;
  font-weight: 800;
}

.overview-account image {
  width: 23rpx;
  height: 23rpx;
  filter: brightness(0) invert(1);
}

.overview-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 12rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 25rpx;
  font-weight: 800;
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 24rpx;
  overflow: hidden;
  border-top: 1rpx solid rgba(255, 255, 255, 0.13);
}

.overview-stat {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding-top: 20rpx;
}

.overview-stat + .overview-stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.13);
}

.overview-value {
  font-size: 28rpx;
  font-weight: 800;
}

.overview-label {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.switching-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.24));
  border-radius: 12rpx;
  background: var(--theme-card-bg, #ffffff);
  box-shadow: 0 12rpx 28rpx var(--theme-soft-shadow, rgba(47, 125, 80, 0.08));
}

.switching-spinner {
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 26rpx;
  border: 4rpx solid var(--theme-soft, #eaf5ed);
  border-top-color: var(--theme-primary, #2f7d50);
  border-radius: 50%;
  animation: switchingSpin 0.8s linear infinite;
}

.switching-text {
  min-width: 0;
  overflow: hidden;
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes switchingSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.circle-list-shell {
  margin-top: 14rpx;
  overflow: hidden;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  border-radius: 16rpx;
  background: var(--theme-card-bg, #ffffff);
  box-shadow: 0 10rpx 26rpx var(--theme-soft-shadow, rgba(47, 125, 80, 0.08));
}

.recent-circle-row {
  position: relative;
  padding: 24rpx;
  border-left: 5rpx solid transparent;
  background: var(--theme-card-bg, #ffffff);
}

.recent-circle-row + .recent-circle-row {
  border-top: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
}

.recent-circle-row.active {
  border-left-color: var(--theme-primary, #2f7d50);
  background: linear-gradient(90deg, var(--theme-soft, #eef7f1), var(--theme-card-bg, #ffffff) 78%);
}

.recent-circle-row.disabled {
  opacity: 0.72;
}

.circle-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.circle-main {
  min-width: 0;
  flex: 1;
}

.circle-title {
  overflow: hidden;
  color: #17211e;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-circle-row .circle-copy {
  margin-top: 6rpx;
  overflow: hidden;
  color: #79827f;
  font-size: 23rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circle-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 15rpx;
  color: #7a8581;
  font-size: 21rpx;
}

.circle-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 148rpx;
  gap: 12rpx;
  margin-top: 18rpx;
}

.small-btn {
  height: 64rpx;
  font-size: 24rpx;
}

.circle-settings-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 64rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.14));
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 23rpx;
  font-weight: 700;
}

.circle-settings-btn image {
  width: 27rpx;
  height: 27rpx;
  opacity: 0.72;
  filter: var(--theme-icon-filter, none);
}

.circle-settings-btn.only-action {
  grid-column: 1 / -1;
}

.view-all-circles {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 76rpx;
  border-top: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  color: var(--theme-primary, #2f7d50);
  font-size: 24rpx;
  font-weight: 800;
}

.view-all-arrow {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 400;
}

.circle-launchpad {
  margin-top: 20rpx;
  padding: 14rpx;
  border: 1rpx solid var(--theme-card-border, rgba(47, 125, 80, 0.1));
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--theme-soft, #eaf5ed), var(--theme-card-bg, #ffffff));
}

.page-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
}

.circle-action {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  min-width: 0;
  height: 94rpx;
  padding: 0 17rpx;
  border-radius: 14rpx;
}

.circle-action-copy {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.circle-action-title,
.circle-action-hint {
  display: block;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circle-action-title {
  font-size: 24rpx;
  font-weight: 900;
}

.circle-action-hint {
  margin-top: 5rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.join-action {
  background: linear-gradient(135deg, var(--theme-primary, #2f7d50), var(--theme-primary-dark, #1c5638));
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.16));
}

.join-action .circle-action-hint {
  color: rgba(255, 255, 255, 0.72);
}

.create-action {
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.22));
  background: var(--theme-card-bg, #ffffff);
  color: var(--theme-primary-dark, #1c5638);
}

.create-action .circle-action-hint {
  color: var(--theme-primary, #2f7d50);
  opacity: 0.7;
}

.create-action.at-limit {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.circle-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border-radius: 10rpx;
  background: var(--theme-soft, #eaf5ed);
}

.circle-action-icon image {
  width: 28rpx;
  height: 28rpx;
  filter: var(--theme-icon-filter, none);
}

.join-action .circle-action-icon {
  background: rgba(255, 255, 255, 0.18);
}

.join-action .circle-action-icon image {
  filter: brightness(0) invert(1);
}

.circle-home-entry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 84rpx;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
}

.circle-home-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 12rpx;
  background: var(--theme-card-bg, #ffffff);
}

.circle-home-icon image {
  width: 27rpx;
  height: 27rpx;
  filter: var(--theme-icon-filter, none);
}

.circle-home-copy {
  min-width: 0;
  flex: 1;
}

.circle-home-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 900;
}

.circle-home-name {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--theme-primary, #2f7d50);
  font-size: 19rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
  opacity: 0.72;
}

.circle-home-arrow {
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 26rpx;
  opacity: 0.58;
  filter: var(--theme-icon-filter, none);
}

@media (max-width: 350px) {
  .overview-account {
    width: 48rpx;
    padding: 0;
  }

  .overview-account text {
    display: none;
  }

  .overview-title {
    font-size: 30rpx;
  }

  .circle-action {
    gap: 8rpx;
    padding: 0 12rpx;
  }

  .circle-action-title {
    font-size: 22rpx;
  }

  .circle-action-hint {
    font-size: 17rpx;
  }
}
