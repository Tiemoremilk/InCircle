.legal-page {
  padding-top: 22rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.legal-load-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 150rpx - env(safe-area-inset-bottom));
  flex-direction: column;
  padding: 48rpx 36rpx;
  text-align: center;
}

.legal-load-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  border-radius: 16rpx;
  background: var(--theme-soft, #eaf5ed);
}

.legal-load-mark view {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--theme-primary, #2f7d50);
  animation: legalLoadPulse 900ms ease-in-out infinite;
}

.legal-load-mark view:nth-child(2) {
  animation-delay: 120ms;
}

.legal-load-mark view:nth-child(3) {
  animation-delay: 240ms;
}

.legal-load-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  border-radius: 16rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 36rpx;
  font-weight: 900;
}

.legal-load-title {
  margin-top: 22rpx;
  color: #1d2824;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
}

.legal-load-copy {
  max-width: 520rpx;
  margin-top: 9rpx;
  color: #75807c;
  font-size: 23rpx;
  line-height: 1.55;
}

.legal-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 190rpx;
  height: 68rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 11rpx;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

@keyframes legalLoadPulse {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.38;
  }
  50% {
    transform: translateY(-5rpx);
    opacity: 1;
  }
}

.legal-hero {
  padding: 34rpx 32rpx 32rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--theme-primary-dark, #1c5638) 0%, var(--theme-primary, #2f7d50) 70%, var(--theme-accent, #b8d966) 160%);
  color: #ffffff;
  box-shadow: 0 22rpx 50rpx var(--theme-hero-shadow, rgba(47, 125, 80, 0.18));
}

.legal-brand {
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
  line-height: 1;
  font-weight: 800;
}

.legal-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
}

.legal-intro {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.62;
}

.legal-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
  line-height: 1.4;
  font-weight: 700;
}

.legal-meta-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
}

.legal-reading-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 22rpx 2rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  border-radius: 12rpx;
  background: var(--theme-soft, #eaf5ed);
  color: #53605b;
  font-size: 23rpx;
  line-height: 1.5;
}

.reading-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  border-radius: 50%;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
}

.legal-article {
  margin-top: 12rpx;
}

.legal-section {
  padding: 30rpx 2rpx 28rpx;
  border-bottom: 1rpx solid rgba(28, 39, 35, 0.08);
}

.legal-section-title {
  color: #18231f;
  font-size: 30rpx;
  line-height: 1.38;
  font-weight: 900;
}

.legal-paragraph {
  margin-top: 15rpx;
  color: #4f5b57;
  font-size: 26rpx;
  line-height: 1.82;
  text-align: justify;
  word-break: break-word;
}

.legal-list {
  margin-top: 13rpx;
}

.legal-list-row {
  display: flex;
  align-items: flex-start;
  gap: 13rpx;
  margin-top: 13rpx;
  color: #4f5b57;
  font-size: 26rpx;
  line-height: 1.72;
  text-align: justify;
}

.legal-list-dot {
  width: 8rpx;
  height: 8rpx;
  flex: 0 0 8rpx;
  margin-top: 18rpx;
  border-radius: 50%;
  background: var(--theme-primary, #2f7d50);
}

.legal-contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
  border-radius: 14rpx;
  background: #ffffff;
}

.legal-contact-label {
  color: #7b8581;
  font-size: 21rpx;
  line-height: 1.2;
}

.legal-contact-value {
  margin-top: 6rpx;
  color: #26322e;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 800;
  word-break: break-all;
}

.legal-contact-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 14rpx;
  flex: 0 0 auto;
  border-radius: 10rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
  font-size: 22rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.legal-footer {
  margin-top: 30rpx;
  color: #909996;
  font-size: 21rpx;
  text-align: center;
}
