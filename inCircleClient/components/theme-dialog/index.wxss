.theme-dialog-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: var(--incircle-keyboard-inset, 0px);
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.theme-dialog-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(18, 24, 23, 0.48);
  backdrop-filter: blur(8rpx);
  animation: dialog-mask-in 180ms ease-out both;
}

.theme-dialog-panel {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  max-height: 78vh;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 32rpx 90rpx rgba(16, 28, 24, 0.24), 0 8rpx 28rpx var(--dialog-shadow, rgba(47, 125, 80, 0.22));
  animation: dialog-panel-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  box-sizing: border-box;
}

.theme-dialog-accent {
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, var(--dialog-primary, #2f7d50), var(--dialog-accent, #b8d966));
}

.theme-dialog-head {
  display: flex;
  align-items: center;
  padding: 34rpx 34rpx 0;
}

.theme-dialog-symbol {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border: 1rpx solid var(--dialog-shadow, rgba(47, 125, 80, 0.22));
  border-radius: 16rpx;
  background: var(--dialog-soft, #f2faf6);
  color: var(--dialog-primary, #2f7d50);
  box-sizing: border-box;
}

.theme-dialog-title {
  flex: 1;
  min-width: 0;
  color: #18211f;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: 0;
  word-break: break-word;
}

.theme-dialog-content-scroll {
  width: auto;
  height: 36vh;
  margin: 24rpx 34rpx 0;
}

.theme-dialog-content-wrap {
  margin: 24rpx 34rpx 0;
}

.theme-dialog-content {
  display: block;
  color: #626c69;
  font-size: 27rpx;
  line-height: 1.72;
  letter-spacing: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.theme-dialog-actions {
  display: flex;
  align-items: stretch;
  padding: 32rpx 34rpx 34rpx;
}

.theme-dialog-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  width: 0;
  height: 80rpx;
  min-width: 0;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0;
  white-space: nowrap;
  box-sizing: border-box;
}

.theme-dialog-action-spacer {
  flex: 0 0 16rpx;
  width: 16rpx;
  height: 80rpx;
}

.theme-dialog-button::after {
  border: 0;
}

.cancel-button {
  border: 1rpx solid rgba(34, 51, 46, 0.12);
  background: #f7f9f8;
  color: #34413e;
}

.single-action .theme-dialog-button {
  width: 100%;
}

.theme-dialog-actions.stacked-actions {
  flex-direction: column;
}

.stacked-actions .theme-dialog-button {
  flex: 0 0 80rpx;
  width: 100%;
}

.stacked-actions .theme-dialog-action-spacer {
  flex: 0 0 16rpx;
  width: 100%;
  height: 16rpx;
}

.confirm-button {
  border: 1rpx solid transparent;
  background: linear-gradient(135deg, var(--dialog-primary, #2f7d50), var(--dialog-primary-dark, #1c5638));
  color: #ffffff;
  box-shadow: 0 8rpx 14rpx var(--dialog-shadow, rgba(47, 125, 80, 0.18));
}

.tone-danger .theme-dialog-accent {
  background: linear-gradient(90deg, #b63e3e, #df7770);
}

.tone-danger .theme-dialog-symbol {
  border-color: rgba(182, 62, 62, 0.14);
  background: #fff1f0;
  color: #b63e3e;
}

.tone-danger .confirm-button {
  background: linear-gradient(135deg, #c14646, #a93232);
  box-shadow: 0 8rpx 14rpx rgba(177, 50, 50, 0.16);
}

.tone-warning .theme-dialog-accent {
  background: linear-gradient(90deg, #b7791f, #e2ae54);
}

.tone-warning .theme-dialog-symbol {
  border-color: rgba(183, 121, 31, 0.16);
  background: #fff7e8;
  color: #a96916;
}

.tone-warning .confirm-button {
  background: linear-gradient(135deg, #bb7a21, #9c6013);
  box-shadow: 0 8rpx 14rpx rgba(167, 102, 18, 0.16);
}

.confirm-button[disabled] {
  border-color: var(--dialog-disabled-border, rgba(47, 125, 80, 0.18));
  background: var(--dialog-disabled-bg, rgba(47, 125, 80, 0.11));
  color: var(--dialog-disabled-text, #52615a) !important;
  -webkit-text-fill-color: currentColor;
  opacity: 1;
  box-shadow: none;
}

.tone-danger .confirm-button[disabled] {
  border-color: rgba(182, 62, 62, 0.16);
  background: #fae9e7;
  color: #984541 !important;
}

.tone-warning .confirm-button[disabled] {
  border-color: rgba(183, 121, 31, 0.17);
  background: #fff2d8;
  color: #865712 !important;
}

.theme-dialog-verification {
  margin: 24rpx 34rpx 0;
}

.verification-label {
  display: block;
  color: #4f5b57;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 700;
}

.verification-input {
  width: 100%;
  height: 76rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(34, 51, 46, 0.14);
  border-radius: 10rpx;
  background: #f7f9f8;
  color: #1e2925;
  font-size: 26rpx;
  box-sizing: border-box;
}

.symbol-alert,
.symbol-info {
  position: relative;
  width: 28rpx;
  height: 36rpx;
}

.symbol-alert-line,
.symbol-info-line {
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 6rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.symbol-alert-dot,
.symbol-info-dot {
  position: absolute;
  left: 50%;
  bottom: 1rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.symbol-info-dot {
  top: 1rpx;
  bottom: auto;
}

.symbol-info-line {
  top: 13rpx;
  height: 22rpx;
}

.symbol-check {
  width: 28rpx;
  height: 16rpx;
  border-left: 6rpx solid currentColor;
  border-bottom: 6rpx solid currentColor;
  transform: translateY(-3rpx) rotate(-45deg);
  transform-origin: center;
}

.button-pressed {
  opacity: 0.84;
  transform: scale(0.985);
}

.theme-dialog-layer.is-closing .theme-dialog-mask {
  animation: dialog-mask-out 150ms ease-in both;
}

.theme-dialog-layer.is-closing .theme-dialog-panel {
  animation: dialog-panel-out 150ms ease-in both;
}

.theme-dialog-layer.reduce-motion .theme-dialog-mask,
.theme-dialog-layer.reduce-motion .theme-dialog-panel {
  animation-duration: 1ms;
}

@keyframes dialog-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dialog-mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes dialog-panel-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dialog-panel-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
