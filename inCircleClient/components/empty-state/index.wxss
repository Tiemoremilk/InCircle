:host {
  display: block;
  width: 100%;
}

.empty-state {
  position: relative;
  display: flex;
  align-items: center;
  gap: 34rpx;
  width: 100%;
  min-height: 300rpx;
  padding: 40rpx 42rpx;
  overflow: hidden;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.12));
  border-radius: 16rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 254, 250, 0.96) 58%, var(--theme-soft, #eaf5ed) 145%);
  box-shadow: 0 14rpx 34rpx rgba(31, 52, 45, 0.07);
}

.empty-state::after {
  content: "";
  position: absolute;
  right: -34rpx;
  bottom: 26rpx;
  width: 150rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: var(--theme-primary, #2f7d50);
  opacity: 0.07;
  transform: rotate(-12deg);
}

.empty-art {
  position: relative;
  width: 178rpx;
  height: 154rpx;
  flex: 0 0 178rpx;
  animation: empty-art-breathe 4.2s ease-in-out infinite;
}

.empty-sheet {
  position: absolute;
  border-radius: 12rpx;
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.16));
}

.empty-sheet.back {
  left: 26rpx;
  top: 10rpx;
  width: 132rpx;
  height: 112rpx;
  background: var(--theme-soft, #eaf5ed);
  opacity: 0.75;
  transform: rotate(7deg);
}

.empty-sheet.front {
  left: 8rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  width: 148rpx;
  height: 112rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 26rpx rgba(31, 52, 45, 0.09);
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 12rpx;
  background: var(--theme-soft, #eaf5ed);
}

.empty-icon {
  width: 34rpx;
  height: 34rpx;
  filter: var(--theme-icon-filter, brightness(0) saturate(100%) invert(40%) sepia(22%) saturate(1023%) hue-rotate(93deg) brightness(96%) contrast(94%));
}

.empty-art-lines {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.empty-art-line {
  height: 8rpx;
  border-radius: 3rpx;
  background: var(--theme-primary, #2f7d50);
  opacity: 0.18;
}

.empty-art-line.short {
  width: 68%;
  margin-top: 12rpx;
  opacity: 0.1;
}

.empty-tab {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 86rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: var(--theme-primary, #2f7d50);
  opacity: 0.72;
}

.empty-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.empty-eyebrow {
  margin-bottom: 8rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 800;
}

.empty-title {
  color: #1d2825;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.empty-description {
  max-width: 440rpx;
  margin-top: 12rpx;
  color: #707b77;
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 500;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
}

.empty-action:active {
  opacity: 0.86;
  transform: scale(0.98);
}

.empty-action {
  transition: transform 140ms ease, opacity 140ms ease;
}

.is-spacious {
  min-height: 480rpx;
  justify-content: center;
}

.is-compact {
  min-height: 220rpx;
  padding: 30rpx 34rpx;
}

.is-compact .empty-art {
  width: 134rpx;
  height: 118rpx;
  flex-basis: 134rpx;
}

.is-compact .empty-sheet.back {
  left: 20rpx;
  width: 102rpx;
  height: 88rpx;
}

.is-compact .empty-sheet.front {
  left: 4rpx;
  top: 20rpx;
  width: 116rpx;
  height: 88rpx;
  padding: 14rpx;
}

.is-compact .empty-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  flex-basis: 44rpx;
}

.is-compact .empty-icon {
  width: 28rpx;
  height: 28rpx;
}

.is-embedded {
  min-height: 190rpx;
  padding: 26rpx 20rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.is-embedded::after {
  display: none;
}

.is-mini {
  min-height: 96rpx;
  padding: 16rpx 8rpx;
  gap: 18rpx;
}

.is-mini .empty-art {
  width: 68rpx;
  height: 64rpx;
  flex-basis: 68rpx;
  animation: none;
}

.is-mini .empty-sheet.back,
.is-mini .empty-art-lines,
.is-mini .empty-tab {
  display: none;
}

.is-mini .empty-sheet.front {
  left: 0;
  top: 0;
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  justify-content: center;
  box-shadow: none;
  background: var(--theme-soft, #eaf5ed);
}

.is-mini .empty-icon-wrap {
  width: 42rpx;
  height: 42rpx;
  flex-basis: 42rpx;
  background: rgba(255, 255, 255, 0.72);
}

.is-mini .empty-icon {
  width: 26rpx;
  height: 26rpx;
}

.is-mini .empty-title {
  font-size: 25rpx;
}

.is-mini .empty-description {
  margin-top: 5rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.is-mini .empty-action {
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 0 16rpx;
  font-size: 21rpx;
}

.kind-vote .empty-sheet.back {
  transform: rotate(-6deg);
}

.kind-checkin .empty-tab {
  width: 50rpx;
}

.kind-search .empty-sheet.back,
.kind-log .empty-sheet.back {
  opacity: 0.42;
}

@keyframes empty-art-breathe {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6rpx);
  }
}

@media (prefers-reduced-motion: reduce) {
  .empty-art {
    animation: none !important;
  }

  .empty-action {
    transition: none !important;
  }
}
