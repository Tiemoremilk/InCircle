.custom-tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  box-sizing: border-box;
  background: rgba(252, 254, 253, 0.94);
  border-top: 1rpx solid rgba(47, 130, 89, 0.1);
  box-shadow: 0 -10rpx 30rpx rgba(47, 130, 89, 0.08);
  backdrop-filter: blur(18rpx);
}

.custom-tabbar.incircle-theme-sync,
.custom-tabbar.incircle-theme-sync .tabbar-item,
.custom-tabbar.incircle-theme-sync .tabbar-icon {
  transition-duration: 0ms !important;
  transition-delay: 0ms !important;
}

.custom-tabbar-inner {
  display: flex;
  align-items: center;
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  padding: 4rpx 12rpx 6rpx;
}

.tabbar-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 82rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2rpx;
  color: #79827f;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  opacity: 1;
  transition: color 160ms ease, opacity 120ms ease;
}

.tabbar-item:active {
  opacity: 0.82;
}

.tabbar-item.active {
  color: #2f8259;
}

.tabbar-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(50%) sepia(7%) saturate(426%) hue-rotate(111deg) brightness(94%) contrast(88%);
  transform: scale(1);
  transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 140ms ease;
}

.tabbar-label {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tabbar-item.active .tabbar-icon {
  filter: brightness(0) saturate(100%) invert(45%) sepia(18%) saturate(1138%) hue-rotate(96deg) brightness(90%) contrast(86%);
  transform: scale(1.06);
}

