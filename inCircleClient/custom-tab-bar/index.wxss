.custom-tabbar {
  background: var(--tabbar-bg, rgba(252, 254, 253, 0.94));
  border-top-color: var(--tabbar-border, rgba(47, 130, 89, 0.12));
  box-shadow: 0 -10rpx 30rpx var(--tabbar-shadow, rgba(47, 130, 89, 0.08));
}

.custom-tabbar .tabbar-item.active {
  color: var(--tabbar-active, #2f8259);
}

.custom-tabbar .tabbar-item.active .tabbar-icon {
  filter: var(--tabbar-active-filter, brightness(0) saturate(100%) invert(45%) sepia(18%) saturate(1138%) hue-rotate(96deg) brightness(90%) contrast(86%));
}

@media (prefers-reduced-motion: reduce) {
  .tabbar-item,
  .tabbar-icon {
    transition: none !important;
  }

  .tabbar-item.active .tabbar-icon {
    transform: none;
  }
}
