page {
  --incircle-fixed-action-reserve: calc(228rpx + env(safe-area-inset-bottom));
  --motion-press-duration: 140ms;
  --motion-state-duration: 200ms;
  --motion-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  background: linear-gradient(180deg, #f2faf6 0%, #fffefa 48%, #eef7f3 100%);
  color: #19201f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));
}

.incircle-theme-sync,
.incircle-theme-sync button,
.incircle-theme-sync .hero-action,
.incircle-theme-sync .quick-card,
.incircle-theme-sync .category-chip,
.incircle-theme-sync .segment,
.incircle-theme-sync .status-btn,
.incircle-theme-sync .recap-action,
.incircle-theme-sync .theme-swatch,
.incircle-theme-sync .location-picker-action,
.incircle-theme-sync .section-action,
.incircle-theme-sync .view-more-row,
.incircle-theme-sync .rank-tab,
.incircle-theme-sync .member-chip,
.incircle-theme-sync .empty-action,
.incircle-theme-sync .insight-cta,
.incircle-theme-sync .doc-link,
.incircle-theme-sync .doc-delete,
.incircle-theme-sync .edit-btn,
.incircle-theme-sync .create-btn,
.incircle-theme-sync .detail-edit-action {
  transition-duration: 0ms !important;
  transition-delay: 0ms !important;
}

.home-page,
.activities-page,
.tools-page,
.docs-page,
.members-page {
  padding-bottom: var(--incircle-tabbar-page-bottom, 124rpx);
}

.page.vote-detail-page,
.page.bill-detail-page,
.page.doc-detail-page {
  padding-bottom: var(--incircle-fixed-action-reserve, 228rpx);
}

.section {
  margin-top: 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #18211f;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.section-action {
  color: #2f7d50;
  font-size: 24rpx;
  font-weight: 600;
}

.card {
  background: linear-gradient(180deg, #ffffff 0%, #fffefa 100%);
  border: 1rpx solid rgba(47, 125, 80, 0.08);
  border-radius: 16rpx;
  box-shadow: 0 14rpx 36rpx rgba(47, 125, 80, 0.08);
}

.muted {
  color: #79827f;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  white-space: nowrap;
}

.pill-green {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.pill-amber {
  background: #fff0d5;
  color: #a05b00;
}

.pill-blue {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
}

.pill-red {
  background: #ffe9e3;
  color: #b34a34;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #2f7d50 0%, #1c5638 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(47, 125, 80, 0.16);
}

.primary-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 28rpx;
  border: 1rpx solid #dce2df;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #25302e;
  font-size: 28rpx;
  font-weight: 700;
}

.ghost-btn:active {
  background: var(--theme-soft, #eaf5ed);
}

.primary-btn[disabled],
.ghost-btn[disabled],
.primary-btn.disabled,
.ghost-btn.disabled {
  opacity: 0.58;
  transform: none;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.mini-tag {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f6f3;
  color: #4d5653;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid rgba(47, 125, 80, 0.05);
}

.icon-img {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.inline-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.icon-tile {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(47, 125, 80, 0.06);
}

.icon-tile .icon-img {
  width: 44rpx;
  height: 44rpx;
}

.icon-tile.green,
.icon-tile.amber,
.icon-tile.blue,
.icon-tile.red {
  background: var(--theme-soft, #eaf5ed);
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.14));
}

.icon-tile.neutral {
  background: #f3f6f3;
}

.section-icon,
.label-icon,
.hero-icon,
.segment-icon,
.inline-icon,
.icon-img {
  filter: var(--theme-icon-filter, brightness(0) saturate(100%) invert(40%) sepia(22%) saturate(1023%) hue-rotate(93deg) brightness(96%) contrast(94%));
}

.primary-btn .section-icon,
.primary-btn .label-icon,
.primary-btn .hero-icon,
.primary-btn .segment-icon,
.primary-btn .inline-icon,
.primary-btn .icon-img,
.segment.active .segment-icon,
.status-btn.active .section-icon,
.status-btn.active .label-icon,
.status-btn.active .hero-icon,
.status-btn.active .segment-icon,
.status-btn.active .inline-icon,
.status-btn.active .icon-img,
.category-chip.active .section-icon,
.category-chip.active .label-icon,
.category-chip.active .hero-icon,
.category-chip.active .segment-icon,
.category-chip.active .inline-icon,
.category-chip.active .icon-img,
.rank-tab.active .section-icon,
.rank-tab.active .label-icon,
.rank-tab.active .hero-icon,
.rank-tab.active .segment-icon,
.rank-tab.active .inline-icon,
.rank-tab.active .icon-img,
.rule-toggle.active .section-icon,
.rule-toggle.active .label-icon,
.rule-toggle.active .hero-icon,
.rule-toggle.active .segment-icon,
.rule-toggle.active .inline-icon,
.rule-toggle.active .icon-img,
.member-chip.active .section-icon,
.member-chip.active .label-icon,
.member-chip.active .hero-icon,
.member-chip.active .segment-icon,
.member-chip.active .inline-icon,
.member-chip.active .icon-img {
  filter: brightness(0) invert(1);
}

.field-input,
.field-picker,
.field-textarea,
input,
textarea {
  caret-color: var(--theme-primary, #2f7d50);
}

.field-input,
.field-picker,
.field-textarea {
  box-shadow: inset 0 0 0 1rpx rgba(47, 125, 80, 0.02);
}

.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f5f8f5;
  border: 1rpx solid #e6ece8;
}

.location-picker-title {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 900;
}

.location-picker-copy {
  margin-top: 6rpx;
  color: #79827f;
  font-size: 22rpx;
  line-height: 1.4;
}

.location-picker-action {
  flex-shrink: 0;
  min-width: 76rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  text-align: center;
  line-height: 52rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.sheet-mask {
  backdrop-filter: blur(10rpx);
}

.share-ready-sheet {
  width: 100%;
  padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: rgba(252, 253, 250, 0.98);
  border-top: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 -22rpx 58rpx rgba(17, 24, 22, 0.16);
  text-align: center;
}

.share-ready-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.16));
}

.share-ready-title {
  margin-top: 20rpx;
  color: #17211e;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 900;
}

.share-ready-copy {
  max-width: 560rpx;
  margin: 10rpx auto 0;
  color: #79827f;
  font-size: 24rpx;
  line-height: 1.55;
}

.share-ready-primary,
.share-ready-secondary {
  width: 100%;
  margin-top: 24rpx;
}

.share-ready-secondary {
  margin-top: 14rpx;
}

.hero-inline-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  max-width: 70%;
  min-width: 0;
}

.hero-inline-actions > view:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-edit-action {
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  color: #ffffff;
  font-size: 21rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.home-page .sheet-mask,
.activities-page .sheet-mask,
.tools-page .sheet-mask,
.docs-page .sheet-mask,
.members-page .sheet-mask {
  bottom: var(--incircle-tabbar-height, 92rpx);
}

.sticky-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 18;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(252, 253, 250, 0.92);
  border-top: 1rpx solid rgba(47, 125, 80, 0.1);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -12rpx 34rpx rgba(47, 125, 80, 0.08);
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100vh;
  height: 100vh;
  padding-top: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: var(--theme-page-bg, linear-gradient(180deg, #f2faf6 0%, #fffefa 48%, #eef7f3 100%));
}

.home-page.loading-page,
.activities-page.loading-page,
.tools-page.loading-page,
.docs-page.loading-page,
.members-page.loading-page {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.loading-text {
  color: var(--theme-primary-dark, #1c5638);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.45;
}

.loading-panel {
  width: calc(100% - 96rpx);
  max-width: 520rpx;
  padding: 46rpx 34rpx 38rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 24rpx 70rpx var(--theme-button-shadow, rgba(47, 125, 80, 0.14));
  backdrop-filter: blur(18rpx);
  text-align: center;
}

.loading-illustration {
  position: relative;
  width: 138rpx;
  height: 118rpx;
  margin: 0 auto 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--theme-soft, #eaf5ed), #ffffff);
  border: 1rpx solid var(--theme-card-active-border, rgba(47, 125, 80, 0.18));
  animation: loadingFloat 1.8s ease-in-out infinite;
}

.loading-card-line {
  position: absolute;
  left: 28rpx;
  width: 68rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: var(--theme-primary, #2f7d50);
}

.loading-card-line.first {
  top: 34rpx;
}

.loading-card-line.second {
  top: 56rpx;
  width: 84rpx;
  opacity: 0.36;
}

.loading-card-line.third {
  top: 78rpx;
  width: 48rpx;
  opacity: 0.24;
}

.loading-card-mark {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--theme-accent, #b8d966);
  animation: loadingPulse 1.4s ease-in-out infinite;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.loading-dots view {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--theme-primary, #2f7d50);
  opacity: 0.38;
  animation: loadingDot 1.1s ease-in-out infinite;
}

.loading-dots view:nth-child(2) {
  animation-delay: 0.15s;
}

.loading-dots view:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes loadingFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes loadingPulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.9;
  }
  50% {
    transform: scale(0.82);
    opacity: 0.55;
  }
}

@keyframes loadingDot {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.35;
  }
  50% {
    transform: translateY(-6rpx);
    opacity: 0.95;
  }
}

.theme-picker {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.theme-swatch {
  min-height: 104rpx;
  padding: 14rpx 10rpx;
  border: 1rpx solid #e6ece8;
  border-radius: 12rpx;
  background: #ffffff;
  text-align: center;
}

.theme-swatch.active {
  border-color: currentColor;
  box-shadow: 0 10rpx 24rpx rgba(47, 125, 80, 0.1);
}

.theme-swatch:active {
  transform: scale(0.985);
  background: #f7faf7;
}

.swatch-dot {
  width: 46rpx;
  height: 46rpx;
  margin: 0 auto;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72);
}

.swatch-name {
  margin-top: 10rpx;
  color: #4d5653;
  font-size: 22rpx;
  font-weight: 800;
}

/* Motion is reserved for explicit feedback, never for initial page content. */

.loading-panel {
  opacity: 0;
  animation: incircleLoadingReveal 160ms var(--motion-ease-out) 140ms forwards;
}

.sheet-mask {
  animation: incircleMaskReveal 180ms ease-out backwards;
}

.sheet-mask > .create-sheet,
.sheet-mask > .edit-sheet,
.sheet-mask > .share-ready-sheet {
  animation: incircleSheetReveal 260ms var(--motion-ease-out) backwards;
}

.motion-progress {
  transform-origin: left center;
  animation: incircleProgressReveal 560ms var(--motion-ease-out) 90ms backwards;
  transition: width 320ms var(--motion-ease-out), opacity var(--motion-state-duration) ease;
}

.motion-state {
  transition: transform var(--motion-state-duration) var(--motion-ease-out), opacity var(--motion-state-duration) ease,
    color var(--motion-state-duration) ease, background-color var(--motion-state-duration) ease,
    border-color var(--motion-state-duration) ease;
}

.motion-state.active,
.motion-state.selected,
.motion-state.checked,
.motion-state.done,
.motion-state.is-default {
  animation: incircleStatePop 220ms var(--motion-ease-out) backwards;
}

.motion-theme-mark {
  animation: incircleThemeMarkBreath 3.8s ease-in-out infinite;
}

.docs-hero-spark {
  animation: incircleSparkBreath 3.4s ease-in-out infinite;
}

.docs-hero-spark.second {
  animation-delay: -1.7s;
}

button,
.hero-action,
.quick-card,
.category-chip,
.segment,
.status-btn,
.recap-action,
.theme-swatch,
.location-picker-action,
.section-action,
.view-more-row,
.rank-tab,
.member-chip,
.empty-action,
.insight-cta,
.doc-link,
.doc-delete,
.edit-btn,
.create-btn,
.detail-edit-action {
  transition: transform var(--motion-press-duration) ease, opacity var(--motion-press-duration) ease,
    background-color var(--motion-state-duration) ease, border-color var(--motion-state-duration) ease;
}

button:active,
.hero-action:active,
.quick-card:active,
.category-chip:active,
.segment:active,
.status-btn:active,
.recap-action:active,
.theme-swatch:active,
.location-picker-action:active,
.section-action:active,
.view-more-row:active,
.rank-tab:active,
.member-chip:active,
.empty-action:active,
.insight-cta:active,
.doc-link:active,
.doc-delete:active,
.edit-btn:active,
.create-btn:active,
.detail-edit-action:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.92;
}

button[disabled],
button.disabled,
.disabled:active {
  transform: none;
}

@keyframes incircleLoadingReveal {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes incircleMaskReveal {
  from {
    opacity: 0.01;
  }
  to {
    opacity: 1;
  }
}

@keyframes incircleSheetReveal {
  from {
    opacity: 0.01;
  }
  to {
    opacity: 1;
  }
}

@keyframes incircleProgressReveal {
  from {
    opacity: 0.72;
    transform: scaleX(0);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes incircleStatePop {
  0% {
    transform: scale(0.96);
  }
  72% {
    transform: scale(1.025);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes incircleThemeMarkBreath {
  0%,
  100% {
    opacity: 0.88;
    transform: translateY(0) scale(1);
  }
  50% {
    opacity: 1;
    transform: translateY(-3rpx) scale(1.035);
  }
}

@keyframes incircleSparkBreath {
  0%,
  100% {
    opacity: 0.62;
    transform: translateY(0) scale(1);
  }
  50% {
    opacity: 1;
    transform: translateY(-5rpx) scale(1.06);
  }
}

@media (prefers-reduced-motion: reduce) {
  .loading-panel,
  .loading-illustration,
  .loading-card-mark,
  .loading-dots view,
  .switching-spinner,
  .sheet-mask,
  .sheet-mask > .create-sheet,
  .sheet-mask > .edit-sheet,
  .sheet-mask > .share-ready-sheet,
  .motion-progress,
  .motion-state,
  .motion-theme-mark,
  .docs-hero-spark {
    animation: none !important;
  }

  button,
  .hero-action,
  .quick-card,
  .category-chip,
  .segment,
  .status-btn,
  .recap-action,
  .theme-swatch,
  .location-picker-action,
  .section-action,
  .view-more-row,
  .rank-tab,
  .member-chip,
  .empty-action,
  .insight-cta,
  .doc-link,
  .doc-delete,
  .edit-btn,
  .create-btn,
  .detail-edit-action {
    transition: none !important;
  }

  .motion-progress,
  .motion-state {
    transform: none !important;
  }

  .loading-panel {
    opacity: 1;
  }
}

/* Theme palette v5: six vivid anchors plus six quiet, low-saturation surfaces. */
.theme-forest {
  --theme-page-bg: linear-gradient(180deg, #f3faf6 0%, #fffdfc 52%, #eef7f2 100%);
  --theme-primary: #2f8259;
  --theme-primary-dark: #205f42;
  --theme-accent: #b7dd72;
  --theme-soft: #e8f5ed;
  --theme-warm: #f5f8de;
  --theme-danger-soft: #fff0ee;
  --theme-card-active-border: rgba(47, 130, 89, 0.25);
  --theme-hero-shadow: rgba(47, 130, 89, 0.18);
  --theme-button-shadow: rgba(47, 130, 89, 0.15);
  --theme-notice-bg: rgba(248, 254, 251, 0.84);
  --theme-notice-border: rgba(47, 130, 89, 0.21);
  --theme-icon-filter: brightness(0) saturate(100%) invert(45%) sepia(18%) saturate(1138%) hue-rotate(96deg) brightness(90%) contrast(86%);
}

.theme-ocean {
  --theme-page-bg: linear-gradient(180deg, #f2f8fc 0%, #fffefd 52%, #eaf3fa 100%);
  --theme-primary: #3472a8;
  --theme-primary-dark: #24527b;
  --theme-accent: #8fc9e8;
  --theme-soft: #e8f2fa;
  --theme-warm: #eff9f7;
  --theme-danger-soft: #fff1f2;
