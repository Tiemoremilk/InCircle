.ai-ui-page {
  --ai-control-height: 84rpx;
  --ai-title-size: 32rpx;
  --ai-control-size: 27rpx;
  --ai-body-size: 24rpx;
  --ai-meta-size: 22rpx;
  padding-top: 20rpx;
  color: #202b27;
}

.ai-ui-section + .ai-ui-section {
  margin-top: 28rpx;
}

.ai-ui-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 62rpx;
  margin: 0 4rpx 16rpx;
  gap: 20rpx;
}

.ai-ui-section-main {
  min-width: 0;
}

.ai-ui-title {
  color: #202b27;
  font-size: var(--ai-title-size);
  line-height: 1.3;
  font-weight: 800;
}

.ai-ui-caption {
  margin-top: 6rpx;
  color: #858e8b;
  font-size: var(--ai-meta-size);
  line-height: 1.4;
}

.ai-ui-head-action {
  flex-shrink: 0;
  min-height: 50rpx;
  padding: 10rpx 4rpx;
  color: var(--theme-primary, #2f7d50);
  font-size: var(--ai-body-size);
  font-weight: 750;
}

.ai-ui-surface {
  overflow: hidden;
  border: 1rpx solid rgba(73, 91, 83, 0.1);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(35, 54, 46, 0.045);
}

.ai-ui-form {
  padding: 26rpx;
}

.ai-ui-field + .ai-ui-field {
  margin-top: 25rpx;
}

.ai-ui-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 38rpx;
  margin-bottom: 11rpx;
  gap: 16rpx;
}

.ai-ui-label {
  color: #46514d;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 750;
}

.ai-ui-required {
  margin-left: 5rpx;
  color: #b75a48;
}

.ai-ui-field-meta {
  color: #919996;
  font-size: var(--ai-meta-size);
}

.ai-ui-control {
  display: flex;
  align-items: center;
  width: 100%;
  height: var(--ai-control-height);
  min-width: 0;
  padding: 0 20rpx;
  border: 1rpx solid #dde4e0;
  border-radius: 10rpx;
  background: #ffffff;
  color: #1d2824;
  font-size: var(--ai-control-size);
  line-height: 1.4;
}

.ai-ui-control:focus {
  border-color: var(--theme-card-active-border, rgba(47, 125, 80, 0.28));
}

.ai-ui-picker {
  justify-content: space-between;
  gap: 16rpx;
}

.ai-ui-picker-main {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-ui-chevron {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.ai-ui-chevron::before {
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 11rpx;
  height: 11rpx;
  border-right: 3rpx solid var(--theme-primary, #2f7d50);
  border-bottom: 3rpx solid var(--theme-primary, #2f7d50);
  content: "";
  transform: rotate(45deg);
}

.ai-ui-help {
  margin-top: 9rpx;
  color: #87908d;
  font-size: var(--ai-meta-size);
  line-height: 1.5;
}

.ai-ui-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #edf1ef;
}

.ai-ui-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  gap: 20rpx;
}

.ai-ui-switch-main {
  flex: 1;
  min-width: 0;
}

.ai-ui-switch-title {
  color: #34403b;
  font-size: 25rpx;
  font-weight: 750;
}

.ai-ui-switch-copy {
  margin-top: 5rpx;
  color: #89918e;
  font-size: var(--ai-meta-size);
  line-height: 1.4;
}

.ai-ui-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.ai-ui-action-grid .primary-btn,
.ai-ui-action-grid .ghost-btn {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
}

.ai-ui-action-grid .disabled {
  pointer-events: none;
}

.ai-ui-inline-status {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  border-radius: 10rpx;
  background: #f5f7f6;
  color: #68726e;
  font-size: 22rpx;
  line-height: 1.45;
}

.ai-ui-status-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e2e7e4;
  color: #68726e;
  font-size: 20rpx;
  font-weight: 900;
}

.ai-ui-inline-status.success {
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary-dark, #1c5638);
}

.ai-ui-inline-status.success .ai-ui-status-mark {
  background: var(--theme-primary, #2f7d50);
  color: #ffffff;
}

.ai-ui-inline-status.error {
  background: #fff6f3;
  color: #a25040;
}

.ai-ui-inline-status.error .ai-ui-status-mark {
  background: #f4dcd5;
  color: #a25040;
}

.ai-ui-empty {
  display: flex;
  align-items: center;
  min-height: 126rpx;
  padding: 24rpx;
  gap: 16rpx;
}

.ai-ui-empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: var(--theme-soft, #eaf5ed);
  color: var(--theme-primary, #2f7d50);
  font-size: 22rpx;
  font-weight: 900;
}

.ai-ui-empty-main {
  flex: 1;
  min-width: 0;
}

.ai-ui-empty-title {
  color: #2b3632;
  font-size: 26rpx;
  font-weight: 800;
}

.ai-ui-empty-copy {
  margin-top: 5rpx;
  color: #838c89;
  font-size: var(--ai-meta-size);
  line-height: 1.45;
}
