NODE_ENV=production
# Container-internal listener. Public exposure is restricted by the Compose 127.0.0.1 port mapping.
HOST=0.0.0.0
PORT=3000

# Docker Compose uses this internal hostname.
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgres://incircle:change-this-password@postgres:5432/incircle

# Use * while testing behind a private network. Set your real Mini Program domain later.
CORS_ORIGINS=https://your-api.example.com
PUBLIC_BASE_URL=https://your-api.example.com
UPLOAD_DIR=/app/uploads

# First-install legal profile seed. db:migrate fills missing database fields and never overwrites existing values.
LEGAL_OPERATOR_TYPE=individual
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_EFFECTIVE_DATE=

# Required for wx.login -> jscode2session.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional. Enables detailed address lookup for authorized login coordinates.
TENCENT_MAP_KEY=
INCIRCLE_SUPER_ADMIN_OPENIDS=

# Required later when issuing self-hosted sessions.
JWT_SECRET=replace-with-a-long-random-secret

# 32 random bytes. The deploy script creates and preserves this automatically.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_PROVIDER_TIMEOUT_MS=300000
AI_CONTENT_SECURITY_ENABLED=true
